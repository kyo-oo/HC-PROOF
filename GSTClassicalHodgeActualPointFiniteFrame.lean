import GSTClassicalHodgeNonCircularGeometricFrontier
import Mathlib.LinearAlgebra.Dimension.StrongRankCondition

/-!
# Actual finite native point-class frames in every finite Hodge fiber

The key finite-dimensional theorem is a *construction from actual scheme
codimension-p point cycles*, not a declaration that all Hodge classes are
algebraic.  Every finite-dimensional algebraic subspace admits a finite,
linearly independent frame of point classes of cardinality equal to its
geometric rank. Those point classes are obtained directly from projective
cycle geometry.

The rational Hodge dimension need not equal this geometric rank. The
difference is the precise missing Hodge algebraicity problem, not something
to assume or disguise behind abstract Hodge matrix units.

There is no hypothesis that these cycles span the entire Hodge fiber,
no target-cycle preimage, no nonzero commutator, and no conserved charge.
-/

set_option maxHeartbeats 8000000

noncomputable section

open AlgebraicGeometry
open GSTProjectiveOverC
open GSTGeometricRealizationStage2D
open GSTGeometricRealizationStage2F
open GSTGeometricRealizationStage2G
open GSTNativeCodimensionCyclePresentation
open GSTClassicalHodgeFiberedCosmology
open GSTClassicalHodgeGeometricCycleClassSpine
open GSTClassicalHodgeAtomicSpan

namespace GSTClassicalHodgeActualPointFiniteFrame

variable {V : SmoothProjectiveComplexScheme}
variable {H : HodgeBigradedBettiData V}

/-- An actual codimension-p scheme point, viewed as its rational Hodge
class through the genuine native point cycle. -/
noncomputable def actualPointHodgeClass
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (x : CodimensionPoint V.X p) :
    ClassicalHodgeFiber V H p :=
  ⟨H.cycleClass p (codimensionPointCycle V.X p x),
    G.algebraic_is_hodge p _⟩

/-- The true geometric subspace generated by projective point classes.
This is intentionally defined independently of any abstract Hodge basis
or a supplied global cycle lift. -/
noncomputable def actualPointHodgeSpan
    (G : GeometricCycleClassSpine V H)
    (p : Nat) :
    Submodule ℚ (ClassicalHodgeFiber V H p) :=
  Submodule.span ℚ (Set.range (actualPointHodgeClass G p))

/-- A finite, independent set consisting ONLY of actual projective point
classes spans the entire *geometrically realizable* rational Hodge subspace.
The size of this finite set equals the intrinsic geometric rank.

This works in EVERY finite-dimensional Hodge fiber, no matter whether the
full Hodge conjecture holds there. No geometric surjectivity is supplied. -/
theorem finite_actual_point_hodge_frame
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    [FiniteDimensional ℚ (ClassicalHodgeFiber V H p)] :
    ∃ t : Finset (ClassicalHodgeFiber V H p),
      (t : Set (ClassicalHodgeFiber V H p)) ⊆
        Set.range (actualPointHodgeClass G p) ∧
      t.card = Module.finrank ℚ (actualPointHodgeSpan G p) ∧
      Submodule.span ℚ (t : Set (ClassicalHodgeFiber V H p)) =
        actualPointHodgeSpan G p ∧
      LinearIndepOn ℚ id (t : Set (ClassicalHodgeFiber V H p)) := by
  classical
  letI : Module.Finite ℚ (actualPointHodgeSpan G p) := inferInstance
  exact Submodule.exists_finset_span_eq_linearIndepOn ℚ
    (Set.range (actualPointHodgeClass G p))

/-- A fully indexed version: a finite family of *genuine scheme points*
gives a linearly independent Hodge-frame of maximal geometric rank.
The point scheme carriers, rather than preselected cohomology vectors,
are the resulting witnesses. -/
theorem finite_independent_native_point_basis
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    [FiniteDimensional ℚ (ClassicalHodgeFiber V H p)] :
    ∃ points : Fin (Module.finrank ℚ (actualPointHodgeSpan G p)) →
        CodimensionPoint V.X p,
      LinearIndependent ℚ (fun i => actualPointHodgeClass G p (points i)) ∧
      Submodule.span ℚ
        (Set.range (fun i => actualPointHodgeClass G p (points i))) =
        actualPointHodgeSpan G p := by
  classical
  letI : Module.Finite ℚ (actualPointHodgeSpan G p) := inferInstance
  obtain ⟨b, hmem, hspan, hli⟩ :=
    Submodule.exists_fun_fin_finrank_span_eq ℚ
      (Set.range (actualPointHodgeClass G p))
  choose points hpoints using hmem
  refine ⟨points, ?_, ?_⟩
  · simpa only [hpoints] using hli
  · simpa only [hpoints] using hspan

#check actualPointHodgeClass
#check actualPointHodgeSpan
#check finite_actual_point_hodge_frame
#check finite_independent_native_point_basis

#print axioms finite_actual_point_hodge_frame
#print axioms finite_independent_native_point_basis

end GSTClassicalHodgeActualPointFiniteFrame
