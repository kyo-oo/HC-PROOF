import GSTClassicalHodgeExactGeometricRankDefect
import GSTClassicalHodgeActualNoncommutativeNativeFrame
import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Noncircular GST geometric-defect separators

An *actual missing* rational Hodge direction admits a rational linear
functional which detects it but annihilates every codimension-p point
cycle. Since the point classes generate the entire true algebraic Hodge
subspace, it also annihilates every genuine native algebraic cycle and
EVERY cycle produced from them by the realized correspondence word
engine, including genuine noncommutative commutators.

This is a mathematical frontier certificate, NOT an assumption that the
Hodge conjecture is false. It explains why algebraic-cycle-preserving
operators alone cannot prove the missing universal spanning theorem.

No custom axioms, target-cycle lifts, claimed universal nondegeneracy,
or circular geometric-generation hypotheses occur.
-/

set_option maxHeartbeats 9000000
set_option maxRecDepth 300000

noncomputable section

open scoped BigOperators
open AlgebraicGeometry
open GSTProjectiveOverC
open GSTGeometricRealizationStage2D
open GSTGeometricRealizationStage2F
open GSTGeometricRealizationStage2G
open GSTNativeCodimensionCyclePresentation
open GSTClassicalHodgeFiberedCosmology
open GSTClassicalHodgeAtomicSpan
open GSTClassicalHodgeRankFreeArsenalIrreducibility
open GSTClassicalHodgeGeometricCycleClassSpine
open GSTClassicalHodgeActualPointFiniteFrame
open GSTClassicalHodgeExactGeometricRankDefect
open GSTClassicalHodgeActualNoncommutativeNativeFrame
open GSTClassicalHodgeRealizedCorrespondenceExpressionAlgebra

namespace GSTClassicalHodgeGeometricDefectSeparator

variable {V : SmoothProjectiveComplexScheme}
variable {H : HodgeBigradedBettiData V}
variable {ι : Type*}

/-- A genuine native algebraic cycle, embedded in its rational Hodge fiber.
This is the actual cycle-class map; it is not an arbitrary Hodge vector. -/
noncomputable def actualNativeHodgeClass
    (G : GeometricCycleClassSpine V H)
    (p : Nat) (Z : codimensionCycles V.X p) :
    ClassicalHodgeFiber V H p :=
  ⟨H.cycleClass p Z, G.algebraic_is_hodge p Z⟩

/-- ALL actual native algebraic cycles are in the point-generated Hodge
subspace. This is the proved finite point presentation, not a definition
of all rational Hodge classes as algebraic. -/
theorem actualNativeHodgeClass_mem_actualPointSpan
    (G : GeometricCycleClassSpine V H)
    (p : Nat) (Z : codimensionCycles V.X p) :
    actualNativeHodgeClass G p Z ∈ actualPointHodgeSpan G p := by
  rw [actual_point_span_eq_algebraic_hodge_subspace G p]
  change H.cycleClass p Z ∈ pointCycleClassSpan p (H.cycleClass p)
  rw [← smoothProjective_cycleClass_range_eq_atomic_span V H p]
  exact ⟨Z, rfl⟩

/-- A missing rational Hodge vector admits a concrete *rational* detector.
The detector vanishes on every true codimension-p projective point cycle,
but takes a nonzero value on this missing Hodge vector. -/
theorem missing_hodge_direction_has_point_separator
    (G : GeometricCycleClassSpine V H)
    (p : Nat) (alpha : ClassicalHodgeFiber V H p)
    (hmissing : alpha ∉ actualPointHodgeSpan G p) :
    ∃ ell : ClassicalHodgeFiber V H p →ₗ[ℚ] ℚ,
      ell alpha ≠ 0 ∧
      ∀ x : CodimensionPoint V.X p,
        ell (actualPointHodgeClass G p x) = 0 := by
  obtain ⟨ell, hdetect, hker⟩ :=
    Submodule.exists_le_ker_of_notMem hmissing
  refine ⟨ell, hdetect, ?_⟩
  intro x
  have hx : actualPointHodgeClass G p x ∈ actualPointHodgeSpan G p :=
    Submodule.subset_span ⟨x, rfl⟩
  exact hker hx

/-- Any detector vanishing on projective POINT classes annihilates *all*
genuine native cycle classes, even if generated by intricate correspondences.
This is a hard ceiling on what the current native-operator algebra can reach. -/
theorem point_separator_annihilates_every_native_cycle
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (ell : ClassicalHodgeFiber V H p →ₗ[ℚ] ℚ)
    (hpoint : ∀ x : CodimensionPoint V.X p,
      ell (actualPointHodgeClass G p x) = 0)
    (Z : codimensionCycles V.X p) :
    ell (actualNativeHodgeClass G p Z) = 0 := by
  have hle : actualPointHodgeSpan G p ≤ LinearMap.ker ell := by
    unfold actualPointHodgeSpan
    apply Submodule.span_le.mpr
    rintro y ⟨x, rfl⟩
    change ell (actualPointHodgeClass G p x) = 0
    exact hpoint x
  have hmem := hle (actualNativeHodgeClass_mem_actualPointSpan G p Z)
  exact hmem

/-- A missing Hodge direction is separated from EVERY algebraic cycle,
not just the particular finite point family used in a frame. -/
theorem missing_hodge_direction_separated_from_all_native_cycles
    (G : GeometricCycleClassSpine V H)
    (p : Nat) (alpha : ClassicalHodgeFiber V H p)
    (hmissing : alpha ∉ actualPointHodgeSpan G p) :
    ∃ ell : ClassicalHodgeFiber V H p →ₗ[ℚ] ℚ,
      ell alpha ≠ 0 ∧
      ∀ Z : codimensionCycles V.X p,
        ell (actualNativeHodgeClass G p Z) = 0 := by
  obtain ⟨ell, hdetect, hpoint⟩ :=
    missing_hodge_direction_has_point_separator G p alpha hmissing
  exact ⟨ell, hdetect,
    point_separator_annihilates_every_native_cycle G p ell hpoint⟩

/-- The separator kills every FINITE noncommutative geometric word family.
Commutators and Horner expressions are special cases of actual native
cycle outputs, so no amount of rearranging existing algebraic operators
can evade a genuine missing-direction detector. -/
theorem point_separator_annihilates_all_native_word_frames
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (ell : ClassicalHodgeFiber V H p →ₗ[ℚ] ℚ)
    (hpoint : ∀ x : CodimensionPoint V.X p,
      ell (actualPointHodgeClass G p x) = 0)
    (word : ι → RealizedCorrespondenceExpr V H p)
    (coeff : ι →₀ ℚ) :
    ell (⟨bettiFiniteWordFrame G word coeff,
      bettiFiniteWordFrame_is_hodge G word coeff⟩ :
        ClassicalHodgeFiber V H p) = 0 := by
  have h :=
    point_separator_annihilates_every_native_cycle G p ell hpoint
      (nativeFiniteWordFrame G word coeff)
  simpa only [actualNativeHodgeClass, nativeFiniteWordFrame_cycleClass] using h

/-- Even genuine noncommutativity cannot escape the actual algebraic span.
The only way to eliminate a detected missing Hodge direction is to
establish further geometry making it algebraic; the commutator law itself
cannot manufacture a preimage of an arbitrary nonalgebraic target. -/
theorem point_separator_annihilates_all_geometric_commutators
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (ell : ClassicalHodgeFiber V H p →ₗ[ℚ] ℚ)
    (hpoint : ∀ x : CodimensionPoint V.X p,
      ell (actualPointHodgeClass G p x) = 0)
    (E F : RealizedCorrespondenceExpr V H p) :
    ell (⟨bettiGeometricCommutator G E F,
      bettiGeometricCommutator_is_hodge G E F⟩ :
        ClassicalHodgeFiber V H p) = 0 := by
  have h :=
    point_separator_annihilates_every_native_cycle G p ell hpoint
      (nativeGeometricCommutator G E F)
  simpa only [actualNativeHodgeClass, nativeGeometricCommutator_cycleClass]
    using h

#check actualNativeHodgeClass_mem_actualPointSpan
#check missing_hodge_direction_has_point_separator
#check point_separator_annihilates_every_native_cycle
#check missing_hodge_direction_separated_from_all_native_cycles
#check point_separator_annihilates_all_native_word_frames
#check point_separator_annihilates_all_geometric_commutators

#print axioms missing_hodge_direction_has_point_separator
#print axioms missing_hodge_direction_separated_from_all_native_cycles
#print axioms point_separator_annihilates_all_native_word_frames
#print axioms point_separator_annihilates_all_geometric_commutators

end GSTClassicalHodgeGeometricDefectSeparator
