import GSTK3DiagonalActualStage2G

/-!
# GST K3 Hodge-structure decomposition -> all rational (2,2) algebraic

NEW MATHEMATICAL ROUTE (not a restatement of full Hodge surjectivity):

K3 Hodge theory identifies the non-divisor part of rational (2,2)
on S×S with Hodge endomorphisms of the transcendental weight-two
Hodge structure T(S). For a K3 with only scalar transcendental Hodge
endomorphisms, every such component is a rational multiple of
the ACTUAL algebraic diagonal correspondence.

This file isolates the two mathematically independent K3 facts:

 (1) The kernel of the TRANSCENDENTAL ENDOMORPHISM READOUT is
     contained in the divisor-word subspace generated by already
     known divisor products. Künneth splitting, Hodge type, and
     Lefschetz (1,1) establish this in authentic K3 geometry.

 (2) Every transcendental Hodge endomorphism readout is a rational
     scalar multiple of the genuine diagonal identity readout.
     This is a scalar-End_HS(T(S)) condition, valid for a very
     general K3 but NOT all K3s.

No field asserts that a Hodge class has an algebraic preimage.
No determinant is assumed nonzero and no arbitrary target-cycle
selector or GST ghost-closure is supplied. Under (1) and (2) we
PROVE a unique one-diagonal-mod-divisors decomposition, then
construct a genuine codimension-2 rational algebraic cycle for
EVERY (2,2) Hodge class on this scheme carrier.

These independently geometric K3 Hodge-structure assumptions must
be instantiated for a real product S×S; they are NOT supplied
by the general unconstrained Stage-2G semantic data.
-/

set_option maxHeartbeats 4000000
noncomputable section

open AlgebraicGeometry
open GSTProjectiveOverC
open GSTGeometricRealizationStage2D
open GSTGeometricRealizationStage2F
open GSTGeometricRealizationStage2G
open GSTK3DiagonalActualStage2G

namespace GSTK3TranscendentalHodgeCompleteness

variable {Y : SmoothProjectiveComplexScheme}
variable {H : HodgeBigradedBettiData Y}

/-- The actual native codimension-two cycle-class map restricted to
the TRUE rational Hodge submodule; no abstract cycle-class is invented. -/
noncomputable def nativeHodgeClass
    (G : GenuineK3ProductDiagonalPacket Y H) :
    codimensionCycles Y.X 2 →ₗ[ℚ]
      rationalHodgeSubspace (H.hodgeBigrading 2) :=
  (H.cycleClass 2).codRestrict
    (rationalHodgeSubspace (H.hodgeBigrading 2))
    G.cycle_is_hodge

/-- The span of genuine algebraic divisor-product cycles.
This source is defined on actual native cycles, not on abstract
matrix-unit Hodge vectors. The divisor-index type is unrestricted. -/
noncomputable def genuineDivisorWordHodgeSubspace
    {ι : Type*}
    (G : GenuineK3ProductDiagonalPacket Y H)
    (divisorWords : ι → codimensionCycles Y.X 2) :
    Submodule ℚ (rationalHodgeSubspace (H.hodgeBigrading 2)) :=
  Submodule.span ℚ (Set.range (fun i => nativeHodgeClass G (divisorWords i)))

/-- Every actually constructed divisor product is, tautologically,
in the IMAGE of the true native cycle-class map. Importantly, this
does NOT assert every Hodge class is in that image. -/
theorem genuineDivisorWords_algebraic
    {ι : Type*}
    (G : GenuineK3ProductDiagonalPacket Y H)
    (divisorWords : ι → codimensionCycles Y.X 2) :
    genuineDivisorWordHodgeSubspace G divisorWords ≤
      LinearMap.range (nativeHodgeClass G) := by
  unfold genuineDivisorWordHodgeSubspace
  apply Submodule.span_le.mpr
  rintro x ⟨i, rfl⟩
  exact ⟨divisorWords i, rfl⟩

/-- This is the key K3 Hodge STRUCTURE argument:
if the kernel of the transcendental tensor-to-End_HS(T)
readout consists of divisor words, and the entire
endomorphism algebra is generated by the identity
(diagonal), then EVERY rational Hodge vector differs
from a scalar multiple of the ACTUAL diagonal class
by an honest divisor-word vector.

The conclusion is derived, not an input decomposition. -/
theorem diagonal_generates_hodge_mod_divisors
    {ι E : Type*}
    [AddCommGroup E] [Module ℚ E]
    (G : GenuineK3ProductDiagonalPacket Y H)
    (divisorWords : ι → codimensionCycles Y.X 2)
    (transcendentalReadout :
      rationalHodgeSubspace (H.hodgeBigrading 2) →ₗ[ℚ] E)
    (hKunnethKernel :
      LinearMap.ker transcendentalReadout ≤
        genuineDivisorWordHodgeSubspace G divisorWords)
    (hScalarEndomorphisms :
      ∀ u : E, ∃ c : ℚ,
        u = c • transcendentalReadout
          (nativeHodgeClass G G.diagonal))
    (alpha : rationalHodgeSubspace (H.hodgeBigrading 2)) :
    ∃ c : ℚ,
      alpha - c • nativeHodgeClass G G.diagonal ∈
        genuineDivisorWordHodgeSubspace G divisorWords := by
  obtain ⟨c, hc⟩ := hScalarEndomorphisms
    (transcendentalReadout alpha)
  refine ⟨c, hKunnethKernel ?_⟩
  change transcendentalReadout
    (alpha - c • nativeHodgeClass G G.diagonal) = 0
  rw [map_sub, map_smul, hc]
  exact sub_self _

/-- ALL rational (2,2) Hodge classes on the given actual K3 product
are represented by actual rational codimension-two algebraic cycles,
using only the divisor-product kernel and scalar transcendental End
facts — and the diagonal as the new independent algebraic generator. -/
theorem all_middle_hodge_classes_from_scalar_K3_geometry
    {ι E : Type*}
    [AddCommGroup E] [Module ℚ E]
    (G : GenuineK3ProductDiagonalPacket Y H)
    (divisorWords : ι → codimensionCycles Y.X 2)
    (transcendentalReadout :
      rationalHodgeSubspace (H.hodgeBigrading 2) →ₗ[ℚ] E)
    (hKunnethKernel :
      LinearMap.ker transcendentalReadout ≤
        genuineDivisorWordHodgeSubspace G divisorWords)
    (hScalarEndomorphisms :
      ∀ u : E, ∃ c : ℚ,
        u = c • transcendentalReadout
          (nativeHodgeClass G G.diagonal))
    (alpha : RationalSingularCohomology H.analytification 4)
    (halpha : alpha ∈ rationalHodgeSubspace (H.hodgeBigrading 2)) :
    ∃ Z : codimensionCycles Y.X 2,
      H.cycleClass 2 Z = alpha := by
  let a : rationalHodgeSubspace (H.hodgeBigrading 2) :=
    ⟨alpha, halpha⟩
  obtain ⟨c, hc⟩ :=
    diagonal_generates_hodge_mod_divisors G divisorWords
      transcendentalReadout hKunnethKernel hScalarEndomorphisms a
  have hdiv : a - c • nativeHodgeClass G G.diagonal ∈
      LinearMap.range (nativeHodgeClass G) :=
    (genuineDivisorWords_algebraic G divisorWords) hc
  have hdiag : c • nativeHodgeClass G G.diagonal ∈
      LinearMap.range (nativeHodgeClass G) :=
    (LinearMap.range (nativeHodgeClass G)).smul_mem c
      ⟨G.diagonal, rfl⟩
  have hall : a ∈ LinearMap.range (nativeHodgeClass G) := by
    have hsum := (LinearMap.range (nativeHodgeClass G)).add_mem
      hdiv hdiag
    simpa only [sub_add_cancel] using hsum
  obtain ⟨Z, hZ⟩ := hall
  refine ⟨Z, ?_⟩
  exact congrArg Subtype.val hZ

#check genuineDivisorWords_algebraic
#check diagonal_generates_hodge_mod_divisors
#check all_middle_hodge_classes_from_scalar_K3_geometry
#print axioms all_middle_hodge_classes_from_scalar_K3_geometry

end GSTK3TranscendentalHodgeCompleteness
