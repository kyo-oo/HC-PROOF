import GSTClassicalHodgeAtomicIndependentPointFrontier
import GSTClassicalHodgeActualNoncommutativeNativeFrame

/-!
# GST strict noncircular geometric frontier

The actual realized-correspondence language has genuine native cycle
operators and exact cycle-class naturality. Its cohomological output from
a native algebraic spine therefore ALWAYS lies in the algebraic range.

This proves a mathematical no-escape theorem, not an assumed full Hodge
conclusion. It prevents mistaking a large noncommutative correspondence
algebra for a proof that algebraic cycle classes span the whole Hodge fiber.

With a nonzero spine, demanding invariance of the algebraic subspace under
ALL *abstract Hodge-basis matrix units* is equivalent to the weightwise
Hodge conjecture. That invariance may not be used as a purportedly weaker
geometric input without proving actual geometric realization of the units.

No new axioms, sorry, native preimages of arbitrary target classes, or
universally nonzero commutator assumptions.
-/

set_option maxHeartbeats 9000000

noncomputable section

open AlgebraicGeometry
open GSTProjectiveOverC
open GSTGeometricRealizationStage2D
open GSTGeometricRealizationStage2F
open GSTGeometricRealizationStage2G
open GSTClassicalHodgeFiberedCosmology
open GSTClassicalHodgeAtomicSpan
open GSTClassicalHodgeGeometricCycleClassSpine
open GSTClassicalHodgeLimitlessSpinePropagation
open GSTClassicalHodgeRankFreeArsenalIrreducibility
open GSTClassicalHodgeRealizedCorrespondenceExpressionAlgebra
open GSTClassicalHodgeActualNoncommutativeNativeFrame

namespace GSTClassicalHodgeNonCircularGeometricFrontier

variable {V : SmoothProjectiveComplexScheme}
variable {H : HodgeBigradedBettiData V}

/-- The output of EVERY actually realized finite closed correspondence
expression from the genuine projective spine lies in the algebraic
Hodge subspace.  This is a native construction, not a surjectivity premise. -/
theorem geometric_word_is_algebraic
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (E : RealizedCorrespondenceExpr V H p) :
    E.cohomologyOperator (spineHodgeSeed G p).1 ∈
      pointCycleClassSpan p (H.cycleClass p) := by
  rw [← smoothProjective_cycleClass_range_eq_atomic_span V H p]
  exact ⟨nativeWord G E, nativeWord_cycleClass G E⟩

/-- A genuine *nonalgebraic* Hodge direction, if one exists, cannot be
generated by ANY noncommutative realized correspondence word from the
native projective spine. This is the exact limit of the current arena. -/
theorem no_geometric_word_hits_a_non_algebraic_hodge_direction
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (alpha : ClassicalHodgeFiber V H p)
    (hnot : alpha ∉ AlgebraicHodgeSubspace V H p)
    (E : RealizedCorrespondenceExpr V H p) :
    E.cohomologyOperator (spineHodgeSeed G p).1 ≠ alpha.1 := by
  intro heq
  apply hnot
  change alpha.1 ∈ pointCycleClassSpan p (H.cycleClass p)
  rw [← heq]
  exact geometric_word_is_algebraic G p E

/-- Algebraic subspace stability under all ABSTRACT rank-free Hodge matrix
units is, after a nonzero native spine is built, EXACTLY the weightwise
Hodge conclusion. Thus taking it as an assumption is no easier than the
original Hodge target; actual geometry must supply the missing directions. -/
theorem full_matrix_unit_invariance_iff_weightwise_hodge
    (G : GeometricCycleClassSpine V H)
    (p : Nat)
    (hspine : spineHodgeSeed G p ≠ 0) :
    RankFreeArsenalInvariant (AlgebraicHodgeSubspace V H p) ↔
      (∀ alpha : RationalSingularCohomology H.analytification (2 * p),
        alpha ∈ rationalHodgeSubspace (H.hodgeBigrading p) →
        ∃ Z : codimensionCycles V.X p, H.cycleClass p Z = alpha) := by
  constructor
  · intro hstable alpha halpha
    have hseed : AlgebraicHodgeSubspace V H p ≠ ⊥ :=
      algebraicHodgeSubspace_ne_bot_of_spineSeed G p hspine
    have htop : AlgebraicHodgeSubspace V H p = ⊤ :=
      algebraicHodgeSubspace_eq_top_of_seed_and_arsenal hstable hseed
    have hmem : (⟨alpha, halpha⟩ :
        ClassicalHodgeFiber V H p) ∈ AlgebraicHodgeSubspace V H p := by
      rw [htop]
      trivial
    change alpha ∈ pointCycleClassSpan p (H.cycleClass p) at hmem
    rw [← smoothProjective_cycleClass_range_eq_atomic_span V H p] at hmem
    exact hmem
  · intro hweight i j alpha halpha
    change (hodgeMatrixUnit i j) alpha ∈ AlgebraicHodgeSubspace V H p
    have htop : AlgebraicHodgeSubspace V H p = ⊤ := by
      apply Submodule.eq_top_iff'.2
      intro x
      change x.1 ∈ pointCycleClassSpan p (H.cycleClass p)
      rw [← smoothProjective_cycleClass_range_eq_atomic_span V H p]
      exact hweight x.1 x.2
    rw [htop]
    trivial

#check geometric_word_is_algebraic
#check no_geometric_word_hits_a_non_algebraic_hodge_direction
#check full_matrix_unit_invariance_iff_weightwise_hodge

#print axioms geometric_word_is_algebraic
#print axioms no_geometric_word_hits_a_non_algebraic_hodge_direction
#print axioms full_matrix_unit_invariance_iff_weightwise_hodge

end GSTClassicalHodgeNonCircularGeometricFrontier
