#check ghost_basis_not_scalar_spine
#check ghost_basis_ne_zero
#check GhostSpineMultiplicityWitness
#check OmniversalSeparatorGhost.toSpineMultiplicityWitness
#check failure_yields_ghostSpineMultiplicity
#check bigradedBettiHodge_of_no_ghostSpineMultiplicity

