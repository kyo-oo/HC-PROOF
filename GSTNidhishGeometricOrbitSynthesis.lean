import GSTClassicalHodgeActualGeometricIrreducibility
import GSTClassicalHodgeGeometricMatrixRankLanding

/-!
# Nidhish GST Geometric Orbit Synthesis

Authorship: geometric synthesis scheme motivated by the user's own
GST coordinate-conversion, operator-separation and zeta–Hodge equations.

This is a NEW inductive construction that does not start with a
prescribed Hodge basis, target-class inverse image, a full-rank
determinant, or an abstract GST matrix unit.

From ONE genuine rational codimension-p algebraic cycle Z, construct
all finite geometric words by repeatedly applying ACTUAL realized
Hodge-compatible closed correspondences to native cycles. Every word
produces a genuine rational native cycle, and its cohomology class is
exactly the corresponding composition of REALIZED Hodge operators.

The span of these constructed geometric orbit classes is invariant
under all actual Hodge-compatible correspondences. If the actual
correspondence representation is irreducible and Z has nonzero class,
the geometric orbit spans the entire rational Hodge fiber.

This reduces the earlier nonzero determinant / basis-witness
obligation to an *actual geometric irreducibility* criterion, and
constructs the finite-operator word arena from scheme geometry.
It does NOT prove that arbitrary smooth projective varieties
possess an irreducible correspondence action. That strong assertion
would include the central unresolved algebraicity problem.
-/

set_option maxHeartbeats 20000000
noncomputable section

open AlgebraicGeometry
open GSTProjectiveOverC
open GSTGeometricRealizationStage2D
open GSTGeometricRealizationStage2F
open GSTGeometricRealizationStage2G
open GSTClassicalHodgeFiberedCosmology
open GSTClassicalHodgeGeometricCycleClassSpine
open GSTClassicalHodgeGeometricMatrixRankLanding
open GSTClassicalHodgeRealizedClosedCorrespondenceAlgebra
open GSTClassicalHodgeRankFreeArsenalIrreducibility
open GSTClassicalHodgeActualGeometricIrreducibility
open GSTClassicalHodgeAtomicSpan

namespace GSTNidhishGeometricOrbitSynthesis

variable {V : SmoothProjectiveComplexScheme}
variable {H : HodgeBigradedBettiData V}
variable {p : Nat}

/-- A *finite geometric construction history*: the original native
cycle or any finite sequence of genuinely realized Hodge-compatible
closed correspondences. Identity uses the starting cycle itself. -/
inductive NativeGeometricOrbitWord
    (V : SmoothProjectiveComplexScheme)
    (H : HodgeBigradedBettiData V)
    (p : Nat) : Type 2
  | seed : NativeGeometricOrbitWord V H p
  | next (R : RealizedFiniteClosedCorrespondence V H p)
      (hR : R.HodgeCompatible)
      (w : NativeGeometricOrbitWord V H p) :
      NativeGeometricOrbitWord V H p

/-- Evaluate the word in the actual rational algebraic-cycle group.
Every step is a genuine finite-closed geometric correspondence. -/
noncomputable def nativeOrbitCycle
    (Z : codimensionCycles V.X p) :
    NativeGeometricOrbitWord V H p → codimensionCycles V.X p
  | .seed => Z
  | .next R _ w => R.geometry.nativeOperator p (nativeOrbitCycle Z w)

/-- The full subspace generated by *constructed* actual native cycle
classes; this is NOT a hypothesized complete Hodge basis. -/
noncomputable def nativeOrbitHodgeSpan
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p) :
    Submodule ℚ (ClassicalHodgeFiber V H p) :=
  Submodule.span ℚ
    (Set.range (fun w : NativeGeometricOrbitWord V H p =>
      geometricHodgeClass G (nativeOrbitCycle Z w)))

/-- The native geometric cycle of a nonempty correspondence word has
exactly the corresponding cohomological action. This establishes
cycle-class naturality at the level of entire actual finite words. -/
theorem nativeOrbitCycle_next_class
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p)
    (R : RealizedFiniteClosedCorrespondence V H p)
    (hR : R.HodgeCompatible)
    (w : NativeGeometricOrbitWord V H p) :
    geometricHodgeClass G (nativeOrbitCycle Z (.next R hR w)) =
      R.hodgeOperator hR
        (geometricHodgeClass G (nativeOrbitCycle Z w)) := by
  apply Subtype.ext
  exact R.cycleClass_natural (nativeOrbitCycle Z w)

/-- This constructed orbit really contains the starting native class. -/
theorem seed_in_nativeOrbitHodgeSpan
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p) :
    geometricHodgeClass G Z ∈ nativeOrbitHodgeSpan G Z := by
  unfold nativeOrbitHodgeSpan
  apply Submodule.subset_span
  exact ⟨NativeGeometricOrbitWord.seed, rfl⟩

/-- KEY NEW GEOMETRIC CLOSURE THEOREM.
The actual geometric orbit span is invariant under every genuine
Hodge-compatible realized finite-closed correspondence. This is
proved by induction over the span of the explicitly synthesized
native cycles, not by assuming a full cycle-class range. -/
theorem nativeOrbitHodgeSpan_invariant
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p) :
    InvariantUnderActualHodgeCorrespondences
      (nativeOrbitHodgeSpan G Z) := by
  intro R hR alpha halpha
  induction halpha using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨w, rfl⟩
      change R.hodgeOperator hR
        (geometricHodgeClass G (nativeOrbitCycle Z w)) ∈
        nativeOrbitHodgeSpan G Z
      rw [← nativeOrbitCycle_next_class G Z R hR w]
      unfold nativeOrbitHodgeSpan
      apply Submodule.subset_span
      exact ⟨NativeGeometricOrbitWord.next R hR w, rfl⟩
  | zero =>
      simpa using (nativeOrbitHodgeSpan G Z).zero_mem
  | add x y hx hy ihx ihy =>
      simpa only [map_add] using
        (nativeOrbitHodgeSpan G Z).add_mem ihx ihy
  | smul a x hx ih =>
      simpa only [map_smul] using
        (nativeOrbitHodgeSpan G Z).smul_mem a ih

/-- No geometric orbit of a nonzero seed can be the zero subspace. -/
theorem nonzero_native_seed_orbit_nontrivial
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p)
    (hnz : geometricHodgeClass G Z ≠ 0) :
    nativeOrbitHodgeSpan G Z ≠ ⊥ := by
  intro hz
  have hmem := seed_in_nativeOrbitHodgeSpan G Z
  rw [hz] at hmem
  exact hnz (by simpa using hmem)

/-- A genuinely irreducible correspondence action forces the
EXPLICIT geometric-word orbit (not a postulated basis) to generate
every rational Hodge direction. -/
theorem actual_irreducibility_forces_native_orbit_total
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p)
    (hnz : geometricHodgeClass G Z ≠ 0)
    (hirred : ActualHodgeCorrespondenceIrreducible
      (V := V) (H := H) (p := p)) :
    nativeOrbitHodgeSpan G Z = ⊤ := by
  rcases hirred (nativeOrbitHodgeSpan G Z)
      (nativeOrbitHodgeSpan_invariant G Z) with hb | ht
  · exact False.elim
      ((nonzero_native_seed_orbit_nontrivial G Z hnz) hb)
  · exact ht

/-- Every *geometrically constructed* orbit class stays in the range
of the genuine rational native-to-Hodge cycle-class operator. -/
theorem native_orbit_span_within_actual_cycle_range
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p) :
    nativeOrbitHodgeSpan G Z ≤
      LinearMap.range (nativeToHodgeFiberLinear G) := by
  unfold nativeOrbitHodgeSpan
  apply Submodule.span_le.mpr
  rintro x ⟨w, rfl⟩
  exact ⟨nativeOrbitCycle Z w, rfl⟩

/-- NEW CONSTRUCTIVE ORBIT-TO-HODGE THEOREM.

Under one independent actual-geometric irreducibility theorem, every
rational Hodge class admits a genuine native algebraic cycle obtained
from the linear range containing finite correspondence-word classes.
Neither an initial determinant nor target-basis preimages are assumed.

The unresolved universal question is the GEOMETRIC EXISTENCE of
such an irreducible family for arbitrary smooth projective varieties.
-/
theorem every_hodge_class_of_constructed_actual_orbit
    (G : GeometricCycleClassSpine V H)
    (Z : codimensionCycles V.X p)
    (hnz : geometricHodgeClass G Z ≠ 0)
    (hirred : ActualHodgeCorrespondenceIrreducible
      (V := V) (H := H) (p := p))
    (alpha : RationalSingularCohomology H.analytification (2 * p))
    (halpha : alpha ∈ rationalHodgeSubspace (H.hodgeBigrading p)) :
    ∃ C : codimensionCycles V.X p, H.cycleClass p C = alpha := by
  have htop := actual_irreducibility_forces_native_orbit_total
    G Z hnz hirred
  have hin : (⟨alpha, halpha⟩ : ClassicalHodgeFiber V H p) ∈
      nativeOrbitHodgeSpan G Z := by
    rw [htop]
    trivial
  obtain ⟨C, hC⟩ :=
    native_orbit_span_within_actual_cycle_range G Z hin
  refine ⟨C, ?_⟩
  exact congrArg Subtype.val hC

#check NativeGeometricOrbitWord
#check nativeOrbitCycle
#check nativeOrbitCycle_next_class
#check nativeOrbitHodgeSpan_invariant
#check actual_irreducibility_forces_native_orbit_total
#check native_orbit_span_within_actual_cycle_range
#check every_hodge_class_of_constructed_actual_orbit

#print axioms nativeOrbitHodgeSpan_invariant
#print axioms actual_irreducibility_forces_native_orbit_total
#print axioms every_hodge_class_of_constructed_actual_orbit

end GSTNidhishGeometricOrbitSynthesis
