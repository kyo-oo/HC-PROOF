import Mathlib

/-!
# GST divisor-word native algebraic realization

This is a uniform genuine CONSTRUCTOR for every algebraic expression
in divisor classes, valid over ALL rational cohomology rings, not
just products of projective spaces or CM elliptic curves.

Input:
* a rational graded cycle-class ring morphism cl : C -> H;
* a set of actual algebraic divisors D_i in C;
* any finite ADD/MULTIPLY/RATIONAL-SCALAR expression e in the
  degree-two cohomology classes cl(D_i).

Construction:
* evaluate the exact same expression on the ACTUAL native cycles
  D_i, producing an explicit algebraic rational cycle combination.
* prove its cohomology under cl equals the original expression.

Hence ANY rational Hodge class of an arbitrary smooth projective
variety whose true cohomology is generated by Hodge divisors
has an explicit algebraic representative. This applies, using
independently known cell/Schubert cohomology presentations,
to projective toric varieties, flags and many Grassmannians
with rational cohomology generated by divisors.

This module proves the exact polynomial-lift naturality for
an arbitrary Q-algebra homomorphism; it does NOT claim that
cohomology of EVERY smooth projective variety is generated
by divisor classes. That would be FALSE (primitive middle
Hodge cohomology can have independent nondivisor classes).
The ring identification and codimension grading of a
concrete geometric X are separately required.
-/

set_option maxHeartbeats 20000000
noncomputable section

namespace GSTDivisorWordRealization

/-- Finite rational-expression language over genuine geometric
divisors; every constructor corresponds to an allowed rational
algebraic-cycle operation. -/
inductive RationalDivisorWord (ι : Type*) where
  | rational : ℚ → RationalDivisorWord ι
  | divisor : ι → RationalDivisorWord ι
  | add : RationalDivisorWord ι → RationalDivisorWord ι → RationalDivisorWord ι
  | neg : RationalDivisorWord ι → RationalDivisorWord ι
  | mul : RationalDivisorWord ι → RationalDivisorWord ι → RationalDivisorWord ι

/-- The same finite word can be evaluated in the cycle ring
or in the rational cohomology ring. -/
def eval
    {ι R : Type*} [CommRing R] [Algebra ℚ R]
    (divisor : ι → R) : RationalDivisorWord ι → R
  | .rational q => algebraMap ℚ R q
  | .divisor i => divisor i
  | .add x y => eval divisor x + eval divisor y
  | .neg x => -(eval divisor x)
  | .mul x y => eval divisor x * eval divisor y

/-- Every finite number-manipulation word respects the ACTUAL
cycle-class ring morphism: no Hodge-to-cycle reverse arrow
is used to manufacture the native representative. -/
theorem algebraic_cycleClass_eval
    {ι C H : Type*}
    [CommRing C] [Algebra ℚ C]
    [CommRing H] [Algebra ℚ H]
    (cl : C →ₐ[ℚ] H)
    (D : ι → C) (e : RationalDivisorWord ι) :
    cl (eval D e) = eval (fun i => cl (D i)) e := by
  induction e with
  | rational q => exact cl.commutes q
  | divisor i => rfl
  | add x y ihx ihy => simp [eval, map_add, ihx, ihy]
  | neg x ih => simp [eval, map_neg, ih]
  | mul x y ihx ihy => simp [eval, map_mul, ihx, ihy]

/-- Canonical finite-word algebraic-cycle constructor, without
guessing a target-cycle representative. -/
def constructAlgebraicDivisorWord
    {ι C : Type*}
    [CommRing C] [Algebra ℚ C]
    (D : ι → C) (e : RationalDivisorWord ι) : C :=
  eval D e

/-- Exact correctness of the constructed actual cycle. -/
theorem constructAlgebraicDivisorWord_correct
    {ι C H : Type*}
    [CommRing C] [Algebra ℚ C]
    [CommRing H] [Algebra ℚ H]
    (cl : C →ₐ[ℚ] H)
    (D : ι → C) (e : RationalDivisorWord ι) :
    cl (constructAlgebraicDivisorWord D e) =
      eval (fun i => cl (D i)) e := by
  exact algebraic_cycleClass_eval cl D e

/-- The legitimate geometric completion criterion for varieties
with a separately verified divisor-generated cohomology RING.
The generation premise is checkable by ordinary ring/Schubert
calculations, and is FALSE for some smooth projective varieties.
Thus this is NOT the full Hodge conjecture. -/
theorem every_divisor_word_class_has_native_cycle
    {ι C H : Type*}
    [CommRing C] [Algebra ℚ C]
    [CommRing H] [Algebra ℚ H]
    (cl : C →ₐ[ℚ] H)
    (D : ι → C)
    (alpha : H)
    (hexpr : ∃ e : RationalDivisorWord ι,
      eval (fun i => cl (D i)) e = alpha) :
    ∃ Z : C, cl Z = alpha := by
  obtain ⟨e,he⟩ := hexpr
  exact ⟨constructAlgebraicDivisorWord D e,
    (constructAlgebraicDivisorWord_correct cl D e).trans he⟩

#check algebraic_cycleClass_eval
#check constructAlgebraicDivisorWord_correct
#check every_divisor_word_class_has_native_cycle
#print axioms algebraic_cycleClass_eval
#print axioms every_divisor_word_class_has_native_cycle

end GSTDivisorWordRealization
