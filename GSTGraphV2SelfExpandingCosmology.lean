/-! ## GST all-dimension finite-degree world descent

The multiverse assembly above grows genuine algebraic directions
through independently certified births. A second NEW world law moves
cycle witnesses DOWN a generically finite geometric morphism.
Unlike abstract graph matrix words, the NATIVE pushforward and the
Hodge pullback are separate, explicitly compatible maps. Degree
normalization is rational and valid for every nonzero finite degree.
The result works in arbitrary cycle ranks and Hodge dimensions.
-/

namespace FiniteDegreeNativeDescent

universe uN uH uT uV

structure DegreePacket
    (NS HS NT HT : Type*)
    [AddCommGroup NS] [Module ℚ NS]
    [AddCommGroup HS] [Module ℚ HS]
    [AddCommGroup NT] [Module ℚ NT]
    [AddCommGroup HT] [Module ℚ HT] where
  sourceCycle : NS →ₗ[ℚ] HS
  targetCycle : NT →ₗ[ℚ] HT
  hodgePull : HT →ₗ[ℚ] HS
  nativePush : NS →ₗ[ℚ] NT
  hodgePush : HS →ₗ[ℚ] HT
  degree : ℚ
  degree_ne_zero : degree ≠ 0
  nativePush_sound :
    ∀ Z : NS, targetCycle (nativePush Z) = hodgePush (sourceCycle Z)
  degree_projection :
    ∀ alpha : HT, hodgePush (hodgePull alpha) = degree • alpha

variable {NS HS NT HT : Type*}
    [AddCommGroup NS] [Module ℚ NS]
    [AddCommGroup HS] [Module ℚ HS]
    [AddCommGroup NT] [Module ℚ NT]
    [AddCommGroup HT] [Module ℚ HT]

/-- A nonzero finite-degree GST geometry packet has an INJECTIVE
Hodge pullback. This is a direct consequence of its certified
push-pull degree identity, with no Hodge algebraicity premise.
Consequently a complete Tate world cannot be used for finite-degree
descent onto an original target carrying Hodge channels absent above. -/
theorem finite_degree_hodge_pull_injective
    (D : DegreePacket NS HS NT HT) :
    Function.Injective D.hodgePull := by
  intro alpha beta hab
  have hPush := congrArg D.hodgePush hab
  rw [D.degree_projection alpha, D.degree_projection beta] at hPush
  have hScaled := congrArg (fun z : HT => D.degree⁻¹ • z) hPush
  simpa [smul_smul, D.degree_ne_zero] using hScaled

#check finite_degree_hodge_pull_injective
#print axioms finite_degree_hodge_pull_injective

/-- Explicit actual algebraic representative downstairs: pull the
target Hodge class, represent it using the source's genuine native
cycles, push the cycle back and divide by nonzero geometric degree.
No target native preimage is assumed, constructed using the genuine
projection identity, for arbitrary target dimension and codimension. -/
theorem realize_target_via_degree_pushforward
    (D : DegreePacket NS HS NT HT)
    (hSource : Function.Surjective D.sourceCycle)
    (alpha : HT) :
    ∃ Z : NT, D.targetCycle Z = alpha := by
  obtain ⟨Z, hZ⟩ := hSource (D.hodgePull alpha)
  refine ⟨D.degree⁻¹ • D.nativePush Z, ?_⟩
  calc
    D.targetCycle (D.degree⁻¹ • D.nativePush Z) =
        D.degree⁻¹ • D.targetCycle (D.nativePush Z) := by
          rw [map_smul]
    _ = D.degree⁻¹ • D.hodgePush (D.sourceCycle Z) := by
          rw [D.nativePush_sound Z]
    _ = D.degree⁻¹ • D.hodgePush (D.hodgePull alpha) := by
          rw [hZ]
    _ = D.degree⁻¹ • (D.degree • alpha) := by
          rw [D.degree_projection alpha]
    _ = alpha := by
          simp [smul_smul, D.degree_ne_zero]

/-- The same native descent law is global: a degree-d world map
cannot lose ACTUAL rational algebraic representatives already
constructed above it, even through arbitrarily complicated
source geometry. -/
theorem degree_descent_preserves_all_hodge_classes
    (D : DegreePacket NS HS NT HT)
    (hSource : Function.Surjective D.sourceCycle) :
    Function.Surjective D.targetCycle := by
  intro alpha
  exact realize_target_via_degree_pushforward D hSource alpha


/-! ## Exact iterated GST descent: degrees multiply, witnesses compose

The world-birth calculus may construct a native cycle far above X.
This composition law replaces any TWO generically finite descent
steps by ONE degree packet whose degree is their exact PRODUCT.
The proof checks all actual pushforward and cycle-class equations
at the typed source, intermediate and target worlds.
No middle-world Hodge completeness is inserted as a hypothesis.
-/

variable {NM HM : Type*}
    [AddCommGroup NM] [Module ℚ NM]
    [AddCommGroup HM] [Module ℚ HM]

/-- Fully executable composition of native geometric descent packets,
with degree exactly d₁*d₂, no dimension or tower-length cutoff. -/
def DegreePacket.compose
    (P : DegreePacket NS HS NM HM)
    (Q : DegreePacket NM HM NT HT)
    (hMid : P.targetCycle = Q.sourceCycle) :
    DegreePacket NS HS NT HT where
  sourceCycle := P.sourceCycle
  targetCycle := Q.targetCycle
  hodgePull := P.hodgePull.comp Q.hodgePull
  nativePush := Q.nativePush.comp P.nativePush
  hodgePush := Q.hodgePush.comp P.hodgePush
  degree := P.degree * Q.degree
  degree_ne_zero := mul_ne_zero P.degree_ne_zero Q.degree_ne_zero
  nativePush_sound := by
    intro Z
    simp only [LinearMap.comp_apply]
    rw [Q.nativePush_sound (P.nativePush Z)]
    rw [← hMid, P.nativePush_sound Z]
  degree_projection := by
    intro alpha
    simp only [LinearMap.comp_apply]
    rw [P.degree_projection (Q.hodgePull alpha)]
    rw [map_smul]
    rw [Q.degree_projection alpha]
    rw [smul_smul]

/-- Every cycle constructed by GST in a high source world can be
transported through TWO further generically finite world stages.
Repeated application handles any finite geometric descent chain. -/
theorem two_stage_degree_descent_preserves_all_hodge
    (P : DegreePacket NS HS NM HM)
    (Q : DegreePacket NM HM NT HT)
    (hMid : P.targetCycle = Q.sourceCycle)
    (hSource : Function.Surjective P.sourceCycle) :
    Function.Surjective Q.targetCycle := by
  exact degree_descent_preserves_all_hodge_classes
    (P.compose Q hMid) hSource

/-- New obstruction-transport law: a missing rational Hodge
direction downstairs MUST pull back to a missing Hodge direction
upstairs for any finite nonzero-degree native geometric morphism.
This pinpoints why projecting a nonalgebraic primitive residual
onto a previously solved source cannot conceal it. -/
theorem missing_target_hodge_survives_finite_pullback
    (D : DegreePacket NS HS NT HT)
    (alpha : HT)
    (hMissing : alpha ∉ LinearMap.range D.targetCycle) :
    D.hodgePull alpha ∉ LinearMap.range D.sourceCycle := by
  intro hsource
  obtain ⟨Z, hZ⟩ := hsource
  apply hMissing
  refine ⟨D.degree⁻¹ • D.nativePush Z, ?_⟩
  calc
    D.targetCycle (D.degree⁻¹ • D.nativePush Z) =
        D.degree⁻¹ • D.targetCycle (D.nativePush Z) := by
          rw [map_smul]
    _ = D.degree⁻¹ • D.hodgePush (D.sourceCycle Z) := by
          rw [D.nativePush_sound Z]
    _ = D.degree⁻¹ • D.hodgePush (D.hodgePull alpha) := by
          rw [hZ]
    _ = D.degree⁻¹ • (D.degree • alpha) := by
          rw [D.degree_projection alpha]
    _ = alpha := by
          simp [smul_smul, D.degree_ne_zero]

#check DegreePacket.compose
#check two_stage_degree_descent_preserves_all_hodge
#check missing_target_hodge_survives_finite_pullback
#print axioms DegreePacket.compose
#print axioms missing_target_hodge_survives_finite_pullback

#check DegreePacket
#check realize_target_via_degree_pushforward
#check degree_descent_preserves_all_hodge_classes
#print axioms realize_target_via_degree_pushforward
#print axioms degree_descent_preserves_all_hodge_classes

end FiniteDegreeNativeDescent

/-! ## GST BLOW-UP COUNTEREXAMPLE TEST — GENUINE CYCLE CLASS

For any codimension-two smooth blowup X'=Bl_Y(X), the standard
Chow and rational Hodge blowup formulas split both cycle domain
and (p,p) Hodge target into the base X and shifted center Y.
The canonical cycle-class map is BLOCK DIAGONAL under those
explicit geometric natural isomorphisms.

The following abstract ℚ-linear theorem formalizes the exact
cycle-image and missing-Hodge-direction test, without assuming
either base/center cycle-class map surjective. It applies to
ACTUAL blowups only AFTER the two canonical blowup isomorphisms
and their compatibility with the true Betti cycle map are proved.

Crucially the failure of exceptional pushdown NEVER creates
a new nonalgebraic rational Hodge class: a missing blowup
class must be missing already on the base or on the center.
This is an honest counterexample criterion, not an arbitrary
new Hodge-to-Chow map.
-/

namespace BlowupRationalHodgeTest

variable {NB HB NY HY : Type*}
    [AddCommGroup NB] [Module ℚ NB]
    [AddCommGroup HB] [Module ℚ HB]
    [AddCommGroup NY] [Module ℚ NY]
    [AddCommGroup HY] [Module ℚ HY]

/-- Exact block cycle-class map for a genuine codimension-two
blowup after the geometric Chow/Hodge decomposition comparison:
the base and shifted-center cycle classes are INDEPENDENT. -/
def blowupCanonicalCycleBlock
    (base : NB →ₗ[ℚ] HB) (center : NY →ₗ[ℚ] HY) :
    (NB × NY) →ₗ[ℚ] (HB × HY) where
  toFun z := (base z.1, center z.2)
  map_add' z w := by
    apply Prod.ext <;> simp
  map_smul' a z := by
    apply Prod.ext <;> simp

/-- Exact all-rank rational Hodge criterion in a codimension-two
GST blowup world birth: full canonical cycle image if and only
if BOTH the old world and the lower-degree center are complete. -/
theorem blowupCanonicalCycleBlock_surjective_iff
    (base : NB →ₗ[ℚ] HB) (center : NY →ₗ[ℚ] HY) :
    Function.Surjective (blowupCanonicalCycleBlock base center) ↔
      Function.Surjective base ∧ Function.Surjective center := by
  constructor
  · intro h
    constructor
    · intro u
      obtain ⟨⟨z,w⟩,hzw⟩ := h (u,0)
      exact ⟨z, congrArg Prod.fst hzw⟩
    · intro v
      obtain ⟨⟨z,w⟩,hzw⟩ := h (0,v)
      exact ⟨w, congrArg Prod.snd hzw⟩
  · rintro ⟨hbase,hcenter⟩ ⟨u,v⟩
    obtain ⟨z,hz⟩ := hbase u
    obtain ⟨w,hw⟩ := hcenter v
    refine ⟨(z,w), ?_⟩
    exact Prod.ext hz hw

/-- A candidate nonalgebraic rational Hodge class on the blowup
exists EXACTLY if such a class already exists on its original
base OR on its actual smooth center, in the corresponding grade.
The proof does not change what counts as an algebraic cycle:
all three maps remain their specified native cycle-class maps. -/
theorem blowupCounterexample_iff_base_or_center
    (base : NB →ₗ[ℚ] HB) (center : NY →ₗ[ℚ] HY) :
    (∃ uv : HB × HY,
       uv ∉ LinearMap.range (blowupCanonicalCycleBlock base center)) ↔
      (∃ u : HB, u ∉ LinearMap.range base) ∨
      (∃ v : HY, v ∉ LinearMap.range center) := by
  classical
  constructor
  · rintro ⟨⟨u,v⟩,hMissing⟩
    by_cases hKnown : u ∈ LinearMap.range base
    · right
      refine ⟨v, ?_⟩
      intro hv
      rcases hKnown with ⟨z,hz⟩
      rcases hv with ⟨w,hw⟩
      apply hMissing
      exact ⟨(z,w), Prod.ext hz hw⟩
    · left
      exact ⟨u,hKnown⟩
  · intro h
    rcases h with ⟨u,hu⟩ | ⟨v,hv⟩
    · refine ⟨(u,0), ?_⟩
      intro hmem
      rcases hmem with ⟨⟨z,w⟩,hzw⟩
      exact hu ⟨z, congrArg Prod.fst hzw⟩
    · refine ⟨(0,v), ?_⟩
      intro hmem
      rcases hmem with ⟨⟨z,w⟩,hzw⟩
      exact hv ⟨w, congrArg Prod.snd hzw⟩


/-! ## GST two DIFFERENT geometric blowup centers: no new counterexample

Unlike the existing r-copy same-type center theorem, this treats two
independent centers with potentially entirely different Chow/Hodge
module types, and hence different varieties, dimensions, and degrees.
The canonical blowup comparison must still instantiate each block
map with the genuine Chow/Hodge splitting on geometric schemes.
-/

variable {NC₁ HC₁ NC₂ HC₂ : Type*}
    [AddCommGroup NC₁] [Module ℚ NC₁]
    [AddCommGroup HC₁] [Module ℚ HC₁]
    [AddCommGroup NC₂] [Module ℚ NC₂]
    [AddCommGroup HC₂] [Module ℚ HC₂]

/-- Two actual independently selected center-source channels, with NO
requirement that their native Chow or rational Hodge types coincide. -/
def blowupTwoDistinctCentersCanonicalCycleBlock
    (base : NB →ₗ[ℚ] HB)
    (center₁ : NC₁ →ₗ[ℚ] HC₁)
    (center₂ : NC₂ →ₗ[ℚ] HC₂) :
    ((NB × NC₁) × NC₂) →ₗ[ℚ] ((HB × HC₁) × HC₂) :=
  blowupCanonicalCycleBlock
    (blowupCanonicalCycleBlock base center₁) center₂

/-- Genuine completeness at both heterogeneous smooth centers and the
base is necessary and sufficient for completeness of this born world. -/
theorem blowupTwoDistinctCenters_surjective_iff
    (base : NB →ₗ[ℚ] HB)
    (center₁ : NC₁ →ₗ[ℚ] HC₁)
    (center₂ : NC₂ →ₗ[ℚ] HC₂) :
    Function.Surjective
      (blowupTwoDistinctCentersCanonicalCycleBlock base center₁ center₂) ↔
      Function.Surjective base ∧ Function.Surjective center₁ ∧
        Function.Surjective center₂ := by
  unfold blowupTwoDistinctCentersCanonicalCycleBlock
  rw [blowupCanonicalCycleBlock_surjective_iff,
    blowupCanonicalCycleBlock_surjective_iff]
  tauto

/-- All missing rational Hodge directions after two heterogeneous
blowup births originate in the base or ONE genuine geometric center.
Consequently no such birth can create a rational Hodge counterexample
when these three canonical maps are already surjective. -/
theorem blowupTwoDistinctCenters_missing_iff_old_missing
    (base : NB →ₗ[ℚ] HB)
    (center₁ : NC₁ →ₗ[ℚ] HC₁)
    (center₂ : NC₂ →ₗ[ℚ] HC₂) :
    (∃ uv : (HB × HC₁) × HC₂,
      uv ∉ LinearMap.range
        (blowupTwoDistinctCentersCanonicalCycleBlock
          base center₁ center₂)) ↔
    (∃ a : HB, a ∉ LinearMap.range base) ∨
      (∃ b : HC₁, b ∉ LinearMap.range center₁) ∨
      (∃ c : HC₂, c ∉ LinearMap.range center₂) := by
  unfold blowupTwoDistinctCentersCanonicalCycleBlock
  rw [blowupCounterexample_iff_base_or_center,
    blowupCounterexample_iff_base_or_center]
  tauto

/-- Actual linear witness construction for every class in the twice-born
world, provided complete canonical original/base/center source maps. -/
theorem blowupTwoDistinctCenters_no_counterexample_of_complete_inputs
    (base : NB →ₗ[ℚ] HB)
    (center₁ : NC₁ →ₗ[ℚ] HC₁)
    (center₂ : NC₂ →ₗ[ℚ] HC₂)
    (hBase : Function.Surjective base)
    (h₁ : Function.Surjective center₁)
    (h₂ : Function.Surjective center₂) :
    ∀ a : (HB × HC₁) × HC₂,
      ∃ z : (NB × NC₁) × NC₂,
        blowupTwoDistinctCentersCanonicalCycleBlock
          base center₁ center₂ z = a := by
  exact
    (blowupTwoDistinctCenters_surjective_iff
      base center₁ center₂).mpr ⟨hBase, h₁, h₂⟩

#check blowupTwoDistinctCentersCanonicalCycleBlock
#check blowupTwoDistinctCenters_surjective_iff
#check blowupTwoDistinctCenters_missing_iff_old_missing
#check blowupTwoDistinctCenters_no_counterexample_of_complete_inputs
#print axioms blowupTwoDistinctCenters_missing_iff_old_missing

/-! ## Coupled GST blowup/cosmology defect transport

A genuine codimension-two blowup has the block cycle-class map above.
When a further finite-degree GST descent is supplied, the original
target's missing Hodge class has a SPECIFIC missing base or exceptional
component after pullback. Mixed native source words cannot disguise the
missing block coordinate. The block comparison is a geometric input;
no Hodge-algebraicity or native preimage is assumed. -/

/-- A missing rational Hodge target after finite-degree descent pulls back
to an explicitly missing component of the actual blowup cycle block.
This is the combined exceptional-birth / cosmological-descent test. -/
theorem finite_degree_blowup_missing_target_component
    {NT HT : Type*}
    [AddCommGroup NT] [Module ℚ NT]
    [AddCommGroup HT] [Module ℚ HT]
    (base : NB →ₗ[ℚ] HB) (center : NY →ₗ[ℚ] HY)
    (D : FiniteDegreeNativeDescent.DegreePacket
      (NB × NY) (HB × HY) NT HT)
    (hBlock : D.sourceCycle = blowupCanonicalCycleBlock base center)
    (alpha : HT)
    (hMissing : alpha ∉ LinearMap.range D.targetCycle) :
    (D.hodgePull alpha).1 ∉ LinearMap.range base ∨
    (D.hodgePull alpha).2 ∉ LinearMap.range center := by
  have hMissingUp :
      D.hodgePull alpha ∉
        LinearMap.range (blowupCanonicalCycleBlock base center) := by
    rw [← hBlock]
    exact FiniteDegreeNativeDescent.missing_target_hodge_survives_finite_pullback
      D alpha hMissing
  by_cases hBase : (D.hodgePull alpha).1 ∈ LinearMap.range base
  · right
    intro hCenter
    rcases hBase with ⟨z,wz⟩
    rcases hCenter with ⟨w,ww⟩
    apply hMissingUp
    exact ⟨(z,w), Prod.ext wz ww⟩
  · exact Or.inl hBase

/-- If both the original base and its actual smooth center have complete
canonical rational cycle images, no finite-degree descendant of this
blowup can manufacture a counterexample. The cycles descend by the
verified degree-normalized native pushforward. -/
theorem finite_degree_blowup_complete_descent
    {NT HT : Type*}
    [AddCommGroup NT] [Module ℚ NT]
    [AddCommGroup HT] [Module ℚ HT]
    (base : NB →ₗ[ℚ] HB) (center : NY →ₗ[ℚ] HY)
    (D : FiniteDegreeNativeDescent.DegreePacket
      (NB × NY) (HB × HY) NT HT)
    (hBlock : D.sourceCycle = blowupCanonicalCycleBlock base center)
    (hBase : Function.Surjective base)
    (hCenter : Function.Surjective center) :
    Function.Surjective D.targetCycle := by
  have hSource : Function.Surjective D.sourceCycle := by
    rw [hBlock]
    exact (blowupCanonicalCycleBlock_surjective_iff base center).mpr
      ⟨hBase, hCenter⟩
  exact FiniteDegreeNativeDescent.degree_descent_preserves_all_hodge_classes
    D hSource

