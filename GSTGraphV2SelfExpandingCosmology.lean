import GSTGraphV2OmniversalCore

/-!
# GST GRAPH V2 — SELF-EXPANDING THREE-ROOT COSMOLOGY

This file implements a stronger interpretation of the historical three GST
spaces.

The three spaces are not labels on a fixed graph.  They are three root worlds
of a recursively generated universe of worlds.  Every world may have its own
state type and its own law type.  A causal birth may consume an arbitrarily
indexed family of existing worlds and produce a new world; that new world can
immediately participate in later births.  Thus the ontology itself branches.

Nothing forces two worlds to have the same geometry, dimension language,
coordinate language, state carrier, or law carrier.  Arithmetic is therefore
one branch, not the ambient ontology.

The least world-closure below is impredicative rather than bounded by a finite
rectangle or a fixed construction depth.  It characterizes exactly the
predicates containing the roots and closed under every certified world-birth.
-/

universe u v w z

namespace GSTGraphV2SelfExpandingCosmology

open GSTGraphV2OmniversalCore

/-- A recursively branching GST cosmos.

`World` is a universe of spaces rather than a universe of points.
`State W` is the internal state carrier of world `W`.
`Law W` is the world-specific law/certificate carrier.

A `Birth src target` is a certified causal event saying that the arbitrarily
indexed family of worlds `src` can generate the new world `target`.  Since the
target is itself a `World`, generation can recurse without changing ontology. -/
structure SelfExpandingCosmos where
  World : Type u
  State : World → Type v
  Law : World → Type w
  root : Sector → World
  LocalEvent : {W : World} → State W → State W → Sort z
  Transport : {A B : World} → State A → State B → Sort z
  Birth : {I : Type u} → (I → World) → World → Sort z

namespace SelfExpandingCosmos

variable (C : SelfExpandingCosmos.{u,v,w,z})

/-- A predicate on worlds is cosmologically closed when every certified birth
whose source worlds satisfy the predicate produces another world satisfying
it.  The source family may have any arity in the ambient universe. -/
def WorldClosed (P : C.World → Prop) : Prop :=
  ∀ {I : Type u} {src : I → C.World} {target : C.World},
    C.Birth src target →
    (∀ i, P (src i)) →
    P target

/-- Least closure generated by a seed family and all certified world births.

This definition does not expose a fixed numerical stage.  `W` is in the
closure precisely when every birth-closed predicate containing the seeds must
contain `W`. -/
def WorldClosure (Seed : C.World → Prop) (W : C.World) : Prop :=
  ∀ P : C.World → Prop,
    (∀ X, Seed X → P X) →
    WorldClosed C P →
    P W

/-- Every seed world is already present in its generated cosmos. -/
theorem seed_mem_worldClosure
    (Seed : C.World → Prop) {W : C.World}
    (hW : Seed W) :
    WorldClosure C Seed W := by
  intro P hSeed _hClosed
  exact hSeed W hW

/-- A certified birth from already-generated source worlds produces another
generated world.  This is the recursive expansion rule. -/
theorem birth_mem_worldClosure
    {Seed : C.World → Prop}
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target)
    (hsrc : ∀ i, WorldClosure C Seed (src i)) :
    WorldClosure C Seed target := by
  intro P hSeed hClosed
  apply hClosed e
  intro i
  exact hsrc i P hSeed hClosed

/-- Elimination/induction principle for the impredicative world closure. -/
theorem worldClosure_induction
    {Seed P : C.World → Prop}
    (hSeed : ∀ W, Seed W → P W)
    (hBirth : WorldClosed C P)
    {W : C.World}
    (hW : WorldClosure C Seed W) :
    P W :=
  hW P hSeed hBirth

/-- The three historical GST sectors are now the three root worlds. -/
def RootSeed (W : C.World) : Prop :=
  ∃ s : Sector, C.root s = W

/-- A world belongs to the generated GST cosmos when it lies in the recursive
closure of the three roots. -/
def Generated (W : C.World) : Prop :=
  WorldClosure C (RootSeed C) W

/-- Every one of the three roots is generated. -/
theorem root_generated (s : Sector) :
    Generated C (C.root s) := by
  apply seed_mem_worldClosure C (RootSeed C)
  exact ⟨s, rfl⟩

/-- Recursive generation is closed under arbitrary-arity world births. -/
theorem birth_generated
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target)
    (hsrc : ∀ i, Generated C (src i)) :
    Generated C target := by
  exact birth_mem_worldClosure C e hsrc

/-- Provenance of one historical root through an arbitrarily deep branch.
A world can carry more than one root in its ancestry, so the old three-way
partition can generate genuinely mixed descendants. -/
inductive UsesRoot (s : Sector) : C.World → Prop
  | root : UsesRoot s (C.root s)
  | birth
      {I : Type u} {src : I → C.World} {target : C.World}
      (e : C.Birth src target)
      (i : I)
      (h : UsesRoot s (src i)) :
      UsesRoot s target

/-- The root-origin profile of a world.  This is not restricted to a single
sector: descendants may retain ancestry from any subset of the three roots. -/
def OriginProfile (W : C.World) (s : Sector) : Prop :=
  UsesRoot C s W

/-- A world is mixed when at least two distinct GST roots occur in its causal
ancestry. -/
def MixedOrigin (W : C.World) : Prop :=
  ∃ s t : Sector,
    s ≠ t ∧ UsesRoot C s W ∧ UsesRoot C t W

/-- A world is triadic when all three GST roots occur in its ancestry. -/
def TriadicOrigin (W : C.World) : Prop :=
  ∀ s : Sector, UsesRoot C s W

/-- An emergent world is generated by the root cosmos but is not itself one of
the three roots. -/
def EmergentWorld (W : C.World) : Prop :=
  Generated C W ∧ ∀ s : Sector, C.root s ≠ W

/-- Root provenance propagates through every later birth using that branch. -/
theorem usesRoot_of_birth
    {s : Sector}
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target)
    (i : I)
    (h : UsesRoot C s (src i)) :
    UsesRoot C s target :=
  UsesRoot.birth e i h

/-- Any semantic predicate containing the three roots and stable under world
births holds on the entire recursively generated cosmos. -/
theorem generated_induction
    {P : C.World → Prop}
    (hRoot : ∀ s : Sector, P (C.root s))
    (hBirth : WorldClosed C P)
    {W : C.World}
    (hW : Generated C W) :
    P W := by
  apply worldClosure_induction C (P := P) _ hBirth hW
  intro X hX
  rcases hX with ⟨s, rfl⟩
  exact hRoot s

/-- The ontology has no globally fixed internal state type: each world selects
its own dependent state carrier. -/
abbrev InternalState (W : C.World) := C.State W

/-- Likewise the law language is world-dependent.  A born world can therefore
carry a law type unrelated to the law types of its causal parents. -/
abbrev InternalLaw (W : C.World) := C.Law W

#check SelfExpandingCosmos
#check SelfExpandingCosmos.WorldClosure
#check SelfExpandingCosmos.Generated
#check SelfExpandingCosmos.UsesRoot
#check SelfExpandingCosmos.MixedOrigin
#check SelfExpandingCosmos.TriadicOrigin
#check SelfExpandingCosmos.generated_induction

end SelfExpandingCosmos


/-! ## GST geometry-birth calculus: a NEW source of native cycle directions

The older Graph V2 event monoid transports existing cycles inside one
world. Its self-expanding ontology can also BIRTH new worlds. The
missing geometric law is a genuine two-source birth where (1) parent
cycle geometry and (2) genuinely new exceptional/source geometry are
independently realized in the born world.

These certificates say more than abstract graph reachability: EVERY
new Hodge coordinate must actually decompose into the images of two
independently available geometric sources. Corresponding NATIVE
cycle transports must commute with the genuine cycle-class map.
No native lift of a target Hodge vector is among the packet fields.

Source B can be the direct sum of arbitrarily many exceptional
cohomological channels in a blowup; no numerical Hodge rank limit
occurs. The arbitrary parent/center geometry can be different spaces.
Proving such packets exist for EVERY arbitrary X is NOT implicit in
the graph ontology. This law instead allows genuinely new geometric
cycle directions from NONCELLULAR source worlds, beyond the earlier
within-X CM/NM self-map closure.
-/

namespace NativeGeometryBirth

universe ua ub uc ud ue uf

/-- An actual cross-world geometric birth. A and B contribute
native rational cycles to the newborn world T, while the Hodge
fiber admits an independently geometric TWO-SOURCE decomposition.
The compatibility equations are mandatory, not assumed Hodge-target
preimages. All six spaces may be unrelated modules. -/
structure TwoSourceBirth
    (CA HA CB HB CT HT : Type*)
    [AddCommGroup CA] [Module ℚ CA]
    [AddCommGroup HA] [Module ℚ HA]
    [AddCommGroup CB] [Module ℚ CB]
    [AddCommGroup HB] [Module ℚ HB]
    [AddCommGroup CT] [Module ℚ CT]
    [AddCommGroup HT] [Module ℚ HT] where
  cycleA : CA →ₗ[ℚ] HA
  cycleB : CB →ₗ[ℚ] HB
  cycleT : CT →ₗ[ℚ] HT
  nativeA : CA →ₗ[ℚ] CT
  nativeB : CB →ₗ[ℚ] CT
  hodgeA : HA →ₗ[ℚ] HT
  hodgeB : HB →ₗ[ℚ] HT
  compatA : ∀ z : CA, cycleT (nativeA z) = hodgeA (cycleA z)
  compatB : ∀ z : CB, cycleT (nativeB z) = hodgeB (cycleB z)
  decompose : ∀ alpha : HT, ∃ a : HA, ∃ b : HB,
    hodgeA a + hodgeB b = alpha

variable {CA HA CB HB CT HT : Type*}
    [AddCommGroup CA] [Module ℚ CA]
    [AddCommGroup HA] [Module ℚ HA]
    [AddCommGroup CB] [Module ℚ CB]
    [AddCommGroup HB] [Module ℚ HB]
    [AddCommGroup CT] [Module ℚ CT]
    [AddCommGroup HT] [Module ℚ HT]

/-- A genuine GST world-birth theorem: complete cycle geometry of
BOTH parent/source worlds plus two real native transports and a
cohomological decomposition CONSTRUCT an ACTUAL cycle for every
Hodge class in the born world. Target algebraicity is NOT supplied
as an assumption. -/
theorem every_newborn_hodge_class_has_native_cycle
    (P : TwoSourceBirth CA HA CB HB CT HT)
    (hA : Function.Surjective P.cycleA)
    (hB : Function.Surjective P.cycleB)
    (alpha : HT) :
    ∃ Z : CT, P.cycleT Z = alpha := by
  obtain ⟨a, b, hab⟩ := P.decompose alpha
  obtain ⟨Za, ha⟩ := hA a
  obtain ⟨Zb, hb⟩ := hB b
  refine ⟨P.nativeA Za + P.nativeB Zb, ?_⟩
  calc
    P.cycleT (P.nativeA Za + P.nativeB Zb) =
        P.cycleT (P.nativeA Za) +
          P.cycleT (P.nativeB Zb) := by
            rw [map_add]
    _ = P.hodgeA (P.cycleA Za) +
        P.hodgeB (P.cycleB Zb) := by
          rw [P.compatA, P.compatB]
    _ = P.hodgeA a + P.hodgeB b := by
          rw [ha, hb]
    _ = alpha := hab

/-- Newborn cycles are not limited to parent Hodge directions.
A rational detector annihilating the ENTIRE parent Hodge image
but reading a particular exceptional native cycle nontrivially
proves that B's cycle is genuinely OUTSIDE the parent's image.
No unknown target Hodge class is used to select the cycle. -/
theorem exceptional_native_birth_creates_new_hodge_direction
    (P : TwoSourceBirth CA HA CB HB CT HT)
    (readout : HT →ₗ[ℚ] ℚ)
    (hParent : ∀ a : HA, readout (P.hodgeA a) = 0)
    (Zb : CB)
    (hRead : readout (P.hodgeB (P.cycleB Zb)) ≠ 0) :
    P.cycleT (P.nativeB Zb) ∉ LinearMap.range P.hodgeA := by
  intro hmem
  obtain ⟨a, ha⟩ := hmem
  have hz : readout (P.cycleT (P.nativeB Zb)) = 0 := by
    rw [← ha]
    exact hParent a
  have hbridge := congrArg readout (P.compatB Zb)
  exact hRead (hbridge.symm.trans hz)

/-- World births compose: a source can itself be the native output
of an earlier birth. This is an actual CONSTRUCTOR on cycles, not
an axiom saying the target class was already algebraic. -/
theorem newborn_geometric_completeness
    (P : TwoSourceBirth CA HA CB HB CT HT)
    (hA : Function.Surjective P.cycleA)
    (hB : Function.Surjective P.cycleB) :
    Function.Surjective P.cycleT := by
  intro alpha
  exact every_newborn_hodge_class_has_native_cycle P hA hB alpha


/-! ## Reverse-source reconstruction: exact GST world-defect transport

The first law establishes that TWO cycle-complete source worlds
construct the new Hodge geometry. A geometric BIRTH with ACTUAL
native and Hodge retractions also admits the reverse implication:
if the born world's cycle-class map is surjective, both old
sources have surjective cycle-class maps. This is a new
SPLIT-EXACT world-birth law, not a target-cycle preimage
assumption and not a global Hodge theorem.

Such retracts occur in genuine blowup/projective-bundle geometry
when the Chow/Hodge decomposition and exceptional Gysin maps
are instantiated. A missing Hodge direction cannot be erased
by a reversible algebraic birth; the defect must survive in
one of the source worlds.
-/

/-- A two-source birth with the EXTRA INDEPENDENT geometric data
of cycle-level and Hodge-level retractions onto both sources. -/
structure SplitTwoSourceBirth
    (CA HA CB HB CT HT : Type*)
    [AddCommGroup CA] [Module ℚ CA]
    [AddCommGroup HA] [Module ℚ HA]
    [AddCommGroup CB] [Module ℚ CB]
    [AddCommGroup HB] [Module ℚ HB]
    [AddCommGroup CT] [Module ℚ CT]
    [AddCommGroup HT] [Module ℚ HT]
    extends TwoSourceBirth CA HA CB HB CT HT where
  backNativeA : CT →ₗ[ℚ] CA
  backNativeB : CT →ₗ[ℚ] CB
  backHodgeA : HT →ₗ[ℚ] HA
  backHodgeB : HT →ₗ[ℚ] HB
  backCompatA :
    ∀ Z : CT, cycleA (backNativeA Z) = backHodgeA (cycleT Z)
  backCompatB :
    ∀ Z : CT, cycleB (backNativeB Z) = backHodgeB (cycleT Z)
  leftInverseA : ∀ a : HA, backHodgeA (hodgeA a) = a
  leftInverseB : ∀ b : HB, backHodgeB (hodgeB b) = b

/-- Fully faithful native cycle-class witness transport in both
directions: the newborn world is Hodge-complete if AND ONLY IF both
actual source worlds are Hodge-complete. -/
theorem split_world_birth_hodge_complete_iff_sources
    (P : SplitTwoSourceBirth CA HA CB HB CT HT) :
    Function.Surjective P.cycleT ↔
      Function.Surjective P.cycleA ∧ Function.Surjective P.cycleB := by
  constructor
  · intro hTarget
    constructor
    · intro a
      obtain ⟨Z, hZ⟩ := hTarget (P.hodgeA a)
      refine ⟨P.backNativeA Z, ?_⟩
      calc
        P.cycleA (P.backNativeA Z) = P.backHodgeA (P.cycleT Z) :=
          P.backCompatA Z
        _ = P.backHodgeA (P.hodgeA a) := by rw [hZ]
        _ = a := P.leftInverseA a
    · intro b
      obtain ⟨Z, hZ⟩ := hTarget (P.hodgeB b)
      refine ⟨P.backNativeB Z, ?_⟩
      calc
        P.cycleB (P.backNativeB Z) = P.backHodgeB (P.cycleT Z) :=
          P.backCompatB Z
        _ = P.backHodgeB (P.hodgeB b) := by rw [hZ]
        _ = b := P.leftInverseB b
  · rintro ⟨hA, hB⟩
    exact newborn_geometric_completeness P.toTwoSourceBirth hA hB

/-- A Hodge class MISSING from either source necessarily gives a
missing Hodge direction in the born world. Unlike the old graph
this theorem catches defects created or inherited by new worlds,
including their exceptional source geometry. -/
theorem source_missing_direction_survives_birth
    (P : SplitTwoSourceBirth CA HA CB HB CT HT)
    (a : HA) (hMissing : a ∉ LinearMap.range P.cycleA) :
    P.hodgeA a ∉ LinearMap.range P.cycleT := by
  intro hTarget
  obtain ⟨Z, hZ⟩ := hTarget
  apply hMissing
  refine ⟨P.backNativeA Z, ?_⟩
  calc
    P.cycleA (P.backNativeA Z) = P.backHodgeA (P.cycleT Z) :=
      P.backCompatA Z
    _ = P.backHodgeA (P.hodgeA a) := by rw [hZ]
    _ = a := P.leftInverseA a


/-- A rationally complete base world creates a perfect equivalence:
the newborn world's Hodge algebraicity is controlled EXACTLY by the
independent exceptional/source world. This specializes the new GST
birth law to projective-space blowups (when their genuine split Chow
and Hodge realization packet has been constructed), and exposes why
exceptional worlds CANNOT be ignored even if the host is rational. -/
theorem algebraic_host_complete_iff_exceptional_complete
    (P : SplitTwoSourceBirth CA HA CB HB CT HT)
    (hBase : Function.Surjective P.cycleA) :
    Function.Surjective P.cycleT ↔
      Function.Surjective P.cycleB := by
  constructor
  · intro hT
    exact (split_world_birth_hodge_complete_iff_sources P).mp hT |>.2
  · intro hB
    exact (split_world_birth_hodge_complete_iff_sources P).mpr
      ⟨hBase, hB⟩

/-- Reverse missing-direction transfer for the INDEPENDENT exceptional
source: if a geometric cycle is absent on the exceptional world, no
native class on the born world can realize its embedded Hodge class.
This is an exact algebraic-image detection theorem, not an invented
cycle-class-surjectivity hypothesis. -/
theorem exceptional_missing_direction_survives_birth
    (P : SplitTwoSourceBirth CA HA CB HB CT HT)
    (b : HB) (hMissing : b ∉ LinearMap.range P.cycleB) :
    P.hodgeB b ∉ LinearMap.range P.cycleT := by
  intro hTarget
  obtain ⟨Z, hZ⟩ := hTarget
  apply hMissing
  refine ⟨P.backNativeB Z, ?_⟩
  calc
    P.cycleB (P.backNativeB Z) = P.backHodgeB (P.cycleT Z) :=
      P.backCompatB Z
    _ = P.backHodgeB (P.hodgeB b) := by rw [hZ]
    _ = b := P.leftInverseB b

#check algebraic_host_complete_iff_exceptional_complete
#check exceptional_missing_direction_survives_birth
#print axioms algebraic_host_complete_iff_exceptional_complete
#print axioms exceptional_missing_direction_survives_birth

#check SplitTwoSourceBirth
#check split_world_birth_hodge_complete_iff_sources
#check source_missing_direction_survives_birth
#print axioms split_world_birth_hodge_complete_iff_sources
#print axioms source_missing_direction_survives_birth

#check TwoSourceBirth
#check every_newborn_hodge_class_has_native_cycle
#check exceptional_native_birth_creates_new_hodge_direction
#print axioms every_newborn_hodge_class_has_native_cycle
#print axioms exceptional_native_birth_creates_new_hodge_direction


/-! ## Full GST geometric multiverse: unbounded birth arity and depth

The preceding laws handle one binary split. The original GST ontology
permits a birth with ARBITRARILY many source worlds, all carrying
different native state types and independent world-law types.
This is its genuinely dependent, non-fixed-world extension.

GeometricCycleBirthRealization interprets STATE as an actual native
cycle carrier and LAW as the actual rational Hodge fiber FOR THAT
WORLD. The fields are cycle-class maps and actual birth assembly
maps; they do not insert a target-cycle witness. The source Hodge
assembly is required to be surjective, independently of cycle
algebraicity, as it would be for genuine cellular / blowup / bundle
geometry with the verified realization comparison.

The theorem is unbounded in cardinality of source worlds, depth of
birth ancestry, and dimensions of individual source state types.
It proves honest cycle witnesses for each GENERATED world, provided
the three roots have algebraic representatives and EACH birth is
supplied with independently verified geometric assembly.
The last condition is not automatic from the GST ontology.
-/

/-- Attach a genuine cycle-class realization and geometric assembly
to every certified event in a dependent GST universe. There is no
global common cycle type: the geometry of different worlds can vary
arbitrarily. -/
structure GeometricCycleBirthRealization
    (C : SelfExpandingCosmos.{u,v,w,z}) where
  cycleClass : (W : C.World) → C.State W → C.Law W
  assembleNative :
    ∀ {I : Type u} {src : I → C.World} {target : C.World},
      C.Birth src target →
      ((i : I) → C.State (src i)) → C.State target
  assembleHodge :
    ∀ {I : Type u} {src : I → C.World} {target : C.World},
      C.Birth src target →
      ((i : I) → C.Law (src i)) → C.Law target
  compatible :
    ∀ {I : Type u} {src : I → C.World} {target : C.World}
       (e : C.Birth src target)
       (native : (i : I) → C.State (src i)),
      cycleClass target (assembleNative e native) =
        assembleHodge e (fun i => cycleClass (src i) (native i))
  allHodgeFromSources :
    ∀ {I : Type u} {src : I → C.World} {target : C.World}
       (e : C.Birth src target) (alpha : C.Law target),
      ∃ h : (i : I) → C.Law (src i), assembleHodge e h = alpha

variable {C : SelfExpandingCosmos.{u,v,w,z}}

/-- An explicitly constructed actual native cycle on a NEWBORN
world of ANY arity, given actual native representatives on each
source world. Even the source state carriers may be different types. -/
theorem every_world_birth_has_native_realization
    (R : GeometricCycleBirthRealization C)
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target)
    (sources : ∀ i : I, ∀ alpha : C.Law (src i),
      ∃ Z : C.State (src i), R.cycleClass (src i) Z = alpha)
    (alpha : C.Law target) :
    ∃ Z : C.State target, R.cycleClass target Z = alpha := by
  obtain ⟨h, hh⟩ := R.allHodgeFromSources e alpha
  have hsource : ∀ i : I, ∃ Z : C.State (src i),
      R.cycleClass (src i) Z = h i := by
    intro i
    exact sources i (h i)
  classical
  let native : (i : I) → C.State (src i) :=
    fun i => Classical.choose (hsource i)
  refine ⟨R.assembleNative e native, ?_⟩
  calc
    R.cycleClass target (R.assembleNative e native) =
        R.assembleHodge e
          (fun i => R.cycleClass (src i) (native i)) :=
          R.compatible e native
    _ = R.assembleHodge e h := by
          congr 1
          funext i
          exact Classical.choose_spec (hsource i)
    _ = alpha := hh

/-- UNBOUNDED GST WORLD-CLOSURE LAW. For every world generated by
arbitrary nested certified births from the three historical roots,
construct a native cycle for EVERY rational Hodge class of that
world, regardless of its dimension or rank. This requires genuine
geometric all-source assembly for every event; it neither presumes
surjectivity at target worlds nor manufactures those packets. -/
theorem generated_worlds_have_native_cycles
    (R : GeometricCycleBirthRealization C)
    (rootCycles : ∀ s : Sector,
      ∀ alpha : C.Law (C.root s),
        ∃ Z : C.State (C.root s),
          R.cycleClass (C.root s) Z = alpha)
    {W : C.World}
    (hW : SelfExpandingCosmos.Generated C W) :
    ∀ alpha : C.Law W,
      ∃ Z : C.State W, R.cycleClass W Z = alpha := by
  apply SelfExpandingCosmos.generated_induction C rootCycles
    (P := fun W => ∀ alpha : C.Law W,
      ∃ Z : C.State W, R.cycleClass W Z = alpha) _ hW
  intro I src target e hsrc
  exact every_world_birth_has_native_realization R e hsrc

/-! ## GST exact arbitrary-source split geometric birth

The original ontology permits an arbitrary dependent family of source worlds,
each with its own State and Law. The existing constructive theorem moves
actual native witnesses FORWARD from source worlds into a newly born world.

The previous reverse-defect law covered only TWO fixed vector-space sources.
Here the native and Hodge BACKWARD maps are made geometric data at EVERY
dependent source of ONE birth, with a checked embedding/retraction for that
source. The result is an exact, all-arity if-and-only-if theorem for actual
native representability, plus an explicit certificate that a missing source
direction CANNOT disappear in an allegedly completed newborn world.

This is an upgrade of GST WORLD-BIRTH mathematics, not a claim that every
arbitrary algebraic variety admits a split birth. In the Hodge application
the backward maps must be real Chow/Gysin or projective-bundle maps, not
freely selected inverses to the Hodge cycle-class map.
-/

/-- Arbitrarily many DIFFERENT geometric source worlds, with genuine
cycle- and Hodge-level retractions for each individual source.

The backward native readout is defined on ALL target native cycles and
commutes with the actual source and target cycle-class maps. The Hodge
embedding has an explicit left inverse; no target algebraic preimage
or unknown native Hodge witness occurs among the additional fields. -/
structure SplitGeometricCycleBirthRealization
    (C : SelfExpandingCosmos.{u,v,w,z})
    extends GeometricCycleBirthRealization C where
  backNative :
    ∀ {I : Type u} {src : I → C.World} {target : C.World},
      (e : C.Birth src target) → (i : I) →
      C.State target → C.State (src i)
  backHodge :
    ∀ {I : Type u} {src : I → C.World} {target : C.World},
      (e : C.Birth src target) → (i : I) →
      C.Law target → C.Law (src i)
  includeHodge :
    ∀ {I : Type u} {src : I → C.World} {target : C.World},
      (e : C.Birth src target) → (i : I) →
      C.Law (src i) → C.Law target
  backSound :
    ∀ {I : Type u} {src : I → C.World} {target : C.World}
      (e : C.Birth src target) (i : I) (Z : C.State target),
      cycleClass (src i) (backNative e i Z) =
        backHodge e i (cycleClass target Z)
  backAfterInclude :
    ∀ {I : Type u} {src : I → C.World} {target : C.World}
      (e : C.Birth src target) (i : I) (alpha : C.Law (src i)),
      backHodge e i (includeHodge e i alpha) = alpha

/-- **ARBITRARY-ARITY GST WORLD-BIRTH COMPLETENESS LAW.**
Under independently geometric split native/Hodge birth maps, the
newborn world has algebraic witnesses for ALL its Hodge laws exactly
when EVERY source world does. The worlds can have unrelated cycle
types and law types; there is no finite arity/rank/dimension bound. -/
theorem split_arbitrary_birth_complete_iff_every_source
    (R : SplitGeometricCycleBirthRealization C)
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target) :
    (∀ alpha : C.Law target,
      ∃ Z : C.State target, R.cycleClass target Z = alpha) ↔
    (∀ i : I, ∀ alpha : C.Law (src i),
      ∃ Z : C.State (src i),
        R.cycleClass (src i) Z = alpha) := by
  constructor
  · intro hTarget i alpha
    obtain ⟨Z, hZ⟩ := hTarget (R.includeHodge e i alpha)
    refine ⟨R.backNative e i Z, ?_⟩
    calc
      R.cycleClass (src i) (R.backNative e i Z) =
          R.backHodge e i (R.cycleClass target Z) :=
            R.backSound e i Z
      _ = R.backHodge e i (R.includeHodge e i alpha) := by
            rw [hZ]
      _ = alpha := R.backAfterInclude e i alpha
  · intro hSources alpha
    exact every_world_birth_has_native_realization
      R.toGeometricCycleBirthRealization e hSources alpha

/-- An ACTUAL missing algebraic direction in ANY one source of an
arbitrary-arity GST world birth survives as a missing direction in
the born world. A false all-varieties conclusion can no longer be
hidden behind infinitely many source channels or nested universes. -/
theorem split_arbitrary_birth_missing_source_survives
    (R : SplitGeometricCycleBirthRealization C)
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target) (i : I)
    (alpha : C.Law (src i))
    (hMissing : ∀ Z : C.State (src i),
      R.cycleClass (src i) Z ≠ alpha) :
    ∀ Z : C.State target,
      R.cycleClass target Z ≠ R.includeHodge e i alpha := by
  intro Z hZ
  apply hMissing (R.backNative e i Z)
  calc
    R.cycleClass (src i) (R.backNative e i Z) =
        R.backHodge e i (R.cycleClass target Z) :=
          R.backSound e i Z
    _ = R.backHodge e i (R.includeHodge e i alpha) := by
          rw [hZ]
    _ = alpha := R.backAfterInclude e i alpha

/-- **UNBOUNDED ROOT-ANCESTRY NATIVE DEFECT LAW.**
For a GST root with a genuinely missing Hodge direction, EVERY world
whose self-expanding causal ancestry includes that root retains a
constructively specified missing class, provided all births come with
actual split native/Hodge geometry. The target class is constructed by
the successive GEOMETRIC Hodge inclusions, not postulated as missing.

This is an induction on the ORIGINAL GST universe's arbitrarily deep,
arbitrary-arity world-birth provenance, rather than a two-source model.
It proves that split births alone cannot erase a root's native deficit:
a genuinely novel geometric Hodge source must enter through an
independently realized nonsplit event or a complete root world. -/
theorem missing_root_direction_survives_all_split_descendants
    (R : SplitGeometricCycleBirthRealization C)
    (s : Sector)
    (alpha : C.Law (C.root s))
    (hMissing : ∀ Z : C.State (C.root s),
      R.cycleClass (C.root s) Z ≠ alpha)
    {W : C.World}
    (hW : SelfExpandingCosmos.UsesRoot C s W) :
    ∃ beta : C.Law W,
      ∀ Z : C.State W, R.cycleClass W Z ≠ beta := by
  induction hW with
  | root =>
      exact ⟨alpha, hMissing⟩
  | birth e i h ih =>
      obtain ⟨beta, hbeta⟩ := ih
      exact ⟨R.includeHodge e i beta,
        split_arbitrary_birth_missing_source_survives R e i beta hbeta⟩

#check missing_root_direction_survives_all_split_descendants
#print axioms missing_root_direction_survives_all_split_descendants

/-! ## GST constructive fresh geometric direction from an arbitrary world birth

Unlike split-birth deficit preservation, this is an explicit FORWARD
native constructor. The arbitrary family of actual source native cycles
is assembled by the certified GST birth, and a rational geometric
readout tests its newly born Hodge class against ALL old native
classes. A nonzero independent readout proves that the native-born
Hodge direction lies strictly outside the previous algebraic span.

No `alpha -> cycle` selector or target cycle preimage is assumed.
The independent detector value still requires verification from the
chosen scheme/world geometry; it is NOT implied merely by ontology.
-/

/-- An arbitrary-arity native GST world birth really constructs a
NEW algebraic Hodge direction, provided the independent geometric
readout is nonzero on its ACTUAL assembled source and zero on the
old native span. This extends the previous binary exceptional-cycle
detector to every dependent GST source family and any old index type. -/
theorem arbitrary_world_birth_constructs_fresh_native_direction
    (R : GeometricCycleBirthRealization C)
    {I : Type u} {src : I → C.World} {target : C.World}
    (e : C.Birth src target)
    [AddCommGroup (C.Law target)] [Module ℚ (C.Law target)]
    (sourceCycles : (i : I) → C.State (src i))
    {J : Type u} (oldNative : J → C.State target)
    (geometricRead : C.Law target →ₗ[ℚ] ℚ)
    (hOld : ∀ j : J,
      geometricRead (R.cycleClass target (oldNative j)) = 0)
    (hNew :
      geometricRead
        (R.assembleHodge e
          (fun i => R.cycleClass (src i) (sourceCycles i))) ≠ 0) :
    R.cycleClass target (R.assembleNative e sourceCycles) ∉
      Submodule.span ℚ
        (Set.range (fun j : J => R.cycleClass target (oldNative j))) := by
  intro hspan
  have hker :
      Submodule.span ℚ
        (Set.range (fun j : J => R.cycleClass target (oldNative j))) ≤
      LinearMap.ker geometricRead := by
    apply Submodule.span_le.mpr
    rintro x ⟨j, rfl⟩
    exact LinearMap.mem_ker.mpr (hOld j)
  have hz :
      geometricRead (R.cycleClass target
        (R.assembleNative e sourceCycles)) = 0 :=
    LinearMap.mem_ker.mp (hker hspan)
  rw [R.compatible e sourceCycles] at hz
  exact hNew hz

#check arbitrary_world_birth_constructs_fresh_native_direction
