/-! ## GST original-X source recovery from an exceptional birth

Embed an arbitrary smooth projective original X into projective space
with normal codimension c >= 2 and blow up the ambient space along X.
Write E=P(N), j:E -> Bl_X(P^N), q:E -> X, xi=c1(O_E(1)).

The marked Hodge birth is gamma(a)=j_*(q^*a), in codimension p+1.
Its ORIGINAL-X return is the geometric Chow operation
  W |-> -q_*(xi^(c-2) * j^! W).
There are TWO independent geometry equalities:
  j^*j_* q^*a = -xi*q^*a,
  q_*(xi^(c-1)*q^*a) = a.
They imply return(gamma(a))=a. Both are genuine exceptional
self-intersection / projective-bundle identities; neither asserts
that gamma(a) has an algebraic representative.

We separate the actual Chow and Betti maps. The hypotheses below are
the stated geometric functoriality identities, NOT surjectivity or a
Hodge-to-Chow inverse. Theorems yield a precise return of any genuinely
constructed algebraic exceptional cycle to the SAME original X.
-/

variable {CX CY CE HX HY HE : Type*}
    [AddCommGroup CX] [Module ℚ CX]
    [AddCommGroup CY] [Module ℚ CY]
    [AddCommGroup CE] [Module ℚ CE]
    [AddCommGroup HX] [Module ℚ HX]
    [AddCommGroup HY] [Module ℚ HY]
    [AddCommGroup HE] [Module ℚ HE]

/-- Fiber integration cancels the negative exceptional self-intersection.
In the intended geometry qReturn means q_*(xi^(c-2) * -). -/
theorem exceptional_lift_return_identity
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (a : HX) :
    -(qReturn (jBetti (excGysin a))) = a := by
  rw [hSelf a, map_neg, neg_neg]
  exact hFiber a

/-- The concrete algebraic Chow operation returning a cycle on the
original center X. The inputs are actual j^! and q_*(xi^(c-2)*-)
when this abstract typed theorem is geometrically instantiated. -/
def exceptionalOriginalXCycle
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (W : CY) : CX :=
  -(qChow (jChow W))

/-! ### Exact ambient-pull annihilation

For the geometric ambient world Y=Bl_X(P^N), the exceptional restriction
of an ambient pull pi^*U is q^*(i^*U). The projective-bundle pushforward
q_*(xi^(c-2) q^*(i^*U)) vanishes for c>=2 because the fiber has
dimension c-1. Thus the existing GST return cannot detect ANY purely
ambient pullback K0/Chern/Chow source, independently of its syzygy or
equation presentation. A genuinely exceptional/non-split source is needed.
-/

/-- All actual ambient-projective Chow pullbacks are annihilated by
the original-X exceptional return. `hLowFiber` is exactly the geometric
projective-bundle vanishing in fiber degree c-2 < c-1, not an
algebraic-surjectivity assumption. -/
theorem exceptional_native_return_kills_ambient_pull
    {CA : Type*} [AddCommGroup CA] [Module ℚ CA]
    (ambientPull : CA →ₗ[ℚ] CY)
    (restriction : CA →ₗ[ℚ] CE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (hRestr : ∀ U : CA, jChow (ambientPull U) = restriction U)
    (hLowFiber : ∀ U : CA, qChow (restriction U) = 0)
    (U : CA) :
    exceptionalOriginalXCycle jChow qChow (ambientPull U) = 0 := by
  simp [exceptionalOriginalXCycle, hRestr U, hLowFiber U]

#check exceptional_native_return_kills_ambient_pull
#print axioms exceptional_native_return_kills_ambient_pull

/-- A native exceptional cycle on the blown-up projective space that
represents j_*q^*alpha yields an actual cycle on original X with
exact canonical class alpha. No target preimage is an input on X. -/
theorem exceptional_lift_cycle_recovery
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (a : HX) (W : CY) (hW : clY W = excGysin a) :
    clX (exceptionalOriginalXCycle jChow qChow W) = a := by
  unfold exceptionalOriginalXCycle
  rw [map_neg, hQ (jChow W), hJ W, hW]
  exact exceptional_lift_return_identity jBetti qReturn xiMul qPull
    excGysin hSelf hFiber a

/-- For a marked exceptional Hodge class, native algebraicity on the
blowup is equivalent to native algebraicity on the embedded original X.
A concrete Chow-to-exceptional Gysin map supplies the reverse direction.
This identifies the exact obligation for the blowup/cosmology route. -/
theorem exceptional_lift_range_iff
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (excChow : CX →ₗ[ℚ] CY)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (hExc : ∀ Z : CX, clY (excChow Z) = excGysin (clX Z))
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (a : HX) :
    excGysin a ∈ LinearMap.range clY ↔ a ∈ LinearMap.range clX := by
  constructor
  · rintro ⟨W, hW⟩
    exact ⟨exceptionalOriginalXCycle jChow qChow W,
      exceptional_lift_cycle_recovery clX clY clE jChow qChow
        jBetti qReturn xiMul qPull excGysin hJ hQ
        hSelf hFiber a W hW⟩
  · rintro ⟨Z, hZ⟩
    refine ⟨excChow Z, ?_⟩
    rw [hExc Z, hZ]


/-! ### Rational ambient-blowup completeness and counterexample transfer

These new consequences use ONLY the exceptional geometry self-intersection,
fiber-integration and canonical Chow/Betti naturality equations already
specified above. The forward algebraic birth is on the ambient blowup; no
native Chow preimage of the prescribed original-X target is assumed.
The intended geometric ambient world is Bl_X(P^N), a rational smooth
projective variety when X is a smooth projective center.
-/

/-- Completeness for the (rational) ambient blowup forces completeness for
its original smooth center X. This needs no reverse exceptional Chow lift:
the forward Gysin return already constructs the original-X cycle. -/
theorem exceptional_ambient_complete_forces_original_complete
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (hY : Function.Surjective clY) :
    Function.Surjective clX := by
  intro a
  obtain ⟨W,hW⟩ := hY (excGysin a)
  exact ⟨exceptionalOriginalXCycle jChow qChow W,
    exceptional_lift_cycle_recovery clX clY clE jChow qChow
      jBetti qReturn xiMul qPull excGysin hJ hQ hSelf hFiber a W hW⟩

/-- A genuinely missing rational Hodge class on the original X gives a
SPECIFIC missing exceptional Hodge class on the rational ambient blowup.
This is an implication, not the existence of a counterexample. -/
theorem exceptional_missing_original_forces_ambient_missing
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (a : HX) (ha : a ∉ LinearMap.range clX) :
    excGysin a ∉ LinearMap.range clY := by
  rintro ⟨W,hW⟩
  apply ha
  exact ⟨exceptionalOriginalXCycle jChow qChow W,
    exceptional_lift_cycle_recovery clX clY clE jChow qChow
      jBetti qReturn xiMul qPull excGysin hJ hQ hSelf hFiber a W hW⟩

/-! ### GST exact Picard-birth interpolation on arbitrary ambient blowups

For Y = Bl_X(P^N) and n=p+1=3, let H be the ambient hyperplane
pullback, E the exceptional divisor, and R the actual original-X
exceptional Chow return. For L=O_Y(uH+vE), the degree-three Chern
character yields
  R(ch₃(L)) = (u²v/2)A + (uv²/2)B + (v³/6)C
where A=h², B=-h*s₁(N), C=s₂(N).
These three sources have the CORRECT original-X codimension two.

This proves that 3 explicit genuinely algebraic Picard source tests
at (u,v)=(1,1),(1,2),(1,3) completely determine the period of
EVERY possible (u,v) twist, for ANY linear residual period detector.
It is not a claim that this Picard source sector spans arbitrary
rational Hodge classes. Rather it is a globally quantified precise
test for whether Picard blowup births can ever detect a target.
-/

/-- Universal degree-three exceptional return pairing, expressed only
through the three truly geometric Chern/Segre characteristic periods. -/
def picardCh3ReturnPeriod
    (A B C u v : ℚ) : ℚ :=
  (u^2*v/2)*A + (u*v^2/2)*B + (v^3/6)*C

/-- Exact inverse coefficient recovery from THREE ACTUAL algebraic
blowup line bundles, without any assumed Gram rank:
the interpolation matrix is rationally invertible. -/
theorem picardCh3_three_twists_recover_characteristic_periods
    (A B C : ℚ) :
    let f := fun v : ℚ => picardCh3ReturnPeriod A B C 1 v
    (6*f 1 - 3*f 2 + (2/3)*f 3 = A) ∧
    (-5*f 1 + 4*f 2 - f 3 = B) ∧
    (3*f 1 - 3*f 2 + f 3 = C) := by
  dsimp [picardCh3ReturnPeriod]
  constructor
  · ring
  constructor
  · ring
  · ring

/-- When the three Picard birth tests vanish, all three independent
characteristic periods vanish, and conversely. This is an exact
source-sector detector, not an existence assumption for a Chow source. -/
theorem picardCh3_three_twists_zero_iff_characteristic_zero
    (A B C : ℚ) :
    (picardCh3ReturnPeriod A B C 1 1 = 0 ∧
     picardCh3ReturnPeriod A B C 1 2 = 0 ∧
     picardCh3ReturnPeriod A B C 1 3 = 0) ↔
      (A = 0 ∧ B = 0 ∧ C = 0) := by
  constructor
  · rintro ⟨h1,h2,h3⟩
    have hr :=
      picardCh3_three_twists_recover_characteristic_periods A B C
    dsimp at hr
    rw [h1,h2,h3] at hr
    rcases hr with ⟨hA,hB,hC⟩
    constructor
    · linarith
    constructor
    · linarith
    · linarith
  · rintro ⟨rfl,rfl,rfl⟩
    norm_num [picardCh3ReturnPeriod]

/-- **Uniform infinite-twist exclusion**: only three explicit
line-bundle computations certify that NO ambient hyperplane/exceptional
divisor line bundle in the complete two-parameter Picard family
has nonzero coupling to the chosen original-X residual. -/
theorem picardCh3_three_twists_exhaust_all_sources
    (A B C : ℚ)
    (h1 : picardCh3ReturnPeriod A B C 1 1 = 0)
    (h2 : picardCh3ReturnPeriod A B C 1 2 = 0)
    (h3 : picardCh3ReturnPeriod A B C 1 3 = 0) :
    ∀ (u v : ℚ), picardCh3ReturnPeriod A B C u v = 0 := by
  obtain ⟨hA,hB,hC⟩ :=
    (picardCh3_three_twists_zero_iff_characteristic_zero A B C).mp
      ⟨h1,h2,h3⟩
  intro u v
  simp [picardCh3ReturnPeriod,hA,hB,hC]

#check picardCh3_three_twists_recover_characteristic_periods
#check picardCh3_three_twists_exhaust_all_sources
#print axioms picardCh3_three_twists_exhaust_all_sources

/-- First nontrivial Chern-Segre triangular cancellation, three exceptional
channels. The geometric coefficients satisfy s₁=-c₁ and s₂=c₁²-c₂;
the normal Chern classes invert all exceptional Segre mixing exactly. -/
theorem exceptional_three_channel_chern_segre_correction
    {R : Type*} [CommRing R]
    (c1 c2 a0 a1 a2 : R) :
    let r0 := a0 - c1*a1 + (c1^2-c2)*a2
    let r1 := a1 - c1*a2
    let r2 := a2
    (r0 + c1*r1 + c2*r2 = a0) ∧
      (r1 + c1*r2 = a1) ∧ (r2 = a2) := by
  dsimp
  constructor
  · ring
  constructor
  · ring
  · rfl

#check exceptional_ambient_complete_forces_original_complete
#check exceptional_missing_original_forces_ambient_missing
#check exceptional_three_channel_chern_segre_correction
#print axioms exceptional_ambient_complete_forces_original_complete
#print axioms exceptional_missing_original_forces_ambient_missing
#print axioms exceptional_three_channel_chern_segre_correction


/-! ### GST exceptional native Chow projector on the ambient birth

The geometric exceptional self-intersection and projective-bundle equations
give a Chow-level left inverse before taking Betti classes. This constructs
an idempotent on actual ambient Chow sources, not a formal arbitrary
cohomology projector. It makes precise the original-X native summand isolated
by the blowup cosmology return.
-/

/-- The rational Chow return regarded as an actual linear map. -/
def exceptionalNativeReturn
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX) :
    CY →ₗ[ℚ] CX :=
  (-qChow).comp jChow

/-- For the intended blowup j:E→Y, q:E→X, the hypotheses are the
genuine Chow self-intersection law j^!j_*=-ξ and fiber integration
q_*(ξ^(c-1) q^*(-))=id.  No target Hodge preimage is assumed. -/
theorem exceptional_native_return_left_inverse
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (xiChow : CE →ₗ[ℚ] CE) (qPullChow : CX →ₗ[ℚ] CE)
    (excChow : CX →ₗ[ℚ] CY)
    (hSelfChow : ∀ Z : CX,
      jChow (excChow Z) = -(xiChow (qPullChow Z)))
    (hFiberChow : ∀ Z : CX,
      qChow (xiChow (qPullChow Z)) = Z)
    (Z : CX) :
    exceptionalNativeReturn jChow qChow (excChow Z) = Z := by
  change -(qChow (jChow (excChow Z))) = Z
  rw [hSelfChow Z, map_neg, neg_neg]
  exact hFiberChow Z

/-- A genuine algebraic native Chow endomorphism of the born ambient world. -/
def exceptionalNativeAmbientProjector
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (excChow : CX →ₗ[ℚ] CY) : CY →ₗ[ℚ] CY :=
  excChow.comp (exceptionalNativeReturn jChow qChow)

/-- The exceptional native projector fixes every born cycle from original X. -/
theorem exceptional_native_ambient_projector_fixed
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (xiChow : CE →ₗ[ℚ] CE) (qPullChow : CX →ₗ[ℚ] CE)
    (excChow : CX →ₗ[ℚ] CY)
    (hSelfChow : ∀ Z : CX,
      jChow (excChow Z) = -(xiChow (qPullChow Z)))
    (hFiberChow : ∀ Z : CX,
      qChow (xiChow (qPullChow Z)) = Z)
    (Z : CX) :
    exceptionalNativeAmbientProjector jChow qChow excChow (excChow Z) =
      excChow Z := by
  change excChow (exceptionalNativeReturn jChow qChow (excChow Z)) =
    excChow Z
  rw [exceptional_native_return_left_inverse jChow qChow xiChow
    qPullChow excChow hSelfChow hFiberChow Z]

/-- Exact GST all-source idempotence, from the geometric Chow laws. -/
theorem exceptional_native_ambient_projector_idempotent
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (xiChow : CE →ₗ[ℚ] CE) (qPullChow : CX →ₗ[ℚ] CE)
    (excChow : CX →ₗ[ℚ] CY)
    (hSelfChow : ∀ Z : CX,
      jChow (excChow Z) = -(xiChow (qPullChow Z)))
    (hFiberChow : ∀ Z : CX,
      qChow (xiChow (qPullChow Z)) = Z)
    (W : CY) :
    exceptionalNativeAmbientProjector jChow qChow excChow
      (exceptionalNativeAmbientProjector jChow qChow excChow W) =
    exceptionalNativeAmbientProjector jChow qChow excChow W := by
  change excChow (exceptionalNativeReturn jChow qChow
    (excChow (exceptionalNativeReturn jChow qChow W))) =
    excChow (exceptionalNativeReturn jChow qChow W)
  rw [exceptional_native_return_left_inverse jChow qChow xiChow
    qPullChow excChow hSelfChow hFiberChow
    (exceptionalNativeReturn jChow qChow W)]

/-- Chow-native projector and canonical Betti exceptional projection commute.
The hypotheses are the explicit actual scheme-to-Betti Gysin and push squares. -/
theorem exceptional_native_ambient_projector_betti
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (excChow : CX →ₗ[ℚ] CY)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (excGysin : HX →ₗ[ℚ] HY)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (hExc : ∀ Z : CX, clY (excChow Z) = excGysin (clX Z))
    (W : CY) :
    clY (exceptionalNativeAmbientProjector jChow qChow excChow W) =
      excGysin (-(qReturn (jBetti (clY W)))) := by
  change clY (excChow (exceptionalNativeReturn jChow qChow W)) = _
  calc
    clY (excChow (exceptionalNativeReturn jChow qChow W)) =
        excGysin (clX (exceptionalNativeReturn jChow qChow W)) := hExc _
    _ = excGysin (-(qReturn (jBetti (clY W)))) := by
      congr 1
      change clX (-(qChow (jChow W))) = _
      rw [map_neg, hQ (jChow W), hJ W]

#check exceptionalNativeAmbientProjector
#check exceptional_native_ambient_projector_fixed
#check exceptional_native_ambient_projector_idempotent
#check exceptional_native_ambient_projector_betti
#print axioms exceptional_native_ambient_projector_idempotent
#print axioms exceptional_native_ambient_projector_betti


/-- The ACTUAL original-X residual readout induced from an arbitrary
algebraic perfect-complex/Chow source on the blown-up ambient world.
Unlike exact exceptional target reconstruction, it needs no hypothesis
that the born source already has the target cohomology class. -/
theorem exceptional_native_residual_readout
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (ell : HX →ₗ[ℚ] ℚ) (W : CY) :
    ell (clX (exceptionalOriginalXCycle jChow qChow W)) =
      -(ell (qReturn (jBetti (clY W)))) := by
  simp only [exceptionalOriginalXCycle, map_neg]
  rw [hQ (jChow W), hJ W]

/-- A genuine exceptional birth with NONZERO pulled residual period
constructs a genuine new original-X detecting native cycle. The native
source W is actual input geometry, not a preselected Hodge preimage. -/
theorem exceptional_native_residual_detected_of_birth
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (ell : HX →ₗ[ℚ] ℚ) (W : CY)
    (hDetect : ell (qReturn (jBetti (clY W))) ≠ 0) :
    ell (clX (exceptionalOriginalXCycle jChow qChow W)) ≠ 0 := by
  rw [exceptional_native_residual_readout clX clY clE jChow qChow
    jBetti qReturn hJ hQ ell W]
  exact neg_ne_zero.mpr hDetect

/-- The exceptional target's native readout reproduces EXACTLY the
prescribed original-X readout; this is a cohomological computation,
not an assertion that the target has been algebraized. -/
theorem exceptional_prescribed_target_readout
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (ell : HX →ₗ[ℚ] ℚ) (a : HX) :
    -(ell (qReturn (jBetti (excGysin a)))) = ell a := by
  calc
    -(ell (qReturn (jBetti (excGysin a)))) =
        ell (-(qReturn (jBetti (excGysin a)))) := by simp
    _ = ell a := congrArg ell
      (exceptional_lift_return_identity jBetti qReturn xiMul qPull
        excGysin hSelf hFiber a)

#check exceptional_native_residual_readout
#check exceptional_native_residual_detected_of_birth
#check exceptional_prescribed_target_readout
#print axioms exceptional_native_residual_detected_of_birth


/-- Universal blowup criterion in native algebraic terms: surjectivity of
the canonical class map on a single actual ambient blowup Y suffices to
recover all classes on its arbitrary original smooth center X.
For the intended instantiation Y=Bl_X(P^N), Y itself is rational.
This is a reduction to an exact geometric source constructor on Y,
not an existence claim for such a constructor. -/
theorem exceptional_ambient_surjectivity_forces_original
    (clX : CX →ₗ[ℚ] HX) (clY : CY →ₗ[ℚ] HY)
    (clE : CE →ₗ[ℚ] HE)
    (jChow : CY →ₗ[ℚ] CE) (qChow : CE →ₗ[ℚ] CX)
    (jBetti : HY →ₗ[ℚ] HE) (qReturn : HE →ₗ[ℚ] HX)
    (xiMul : HE →ₗ[ℚ] HE) (qPull : HX →ₗ[ℚ] HE)
    (excGysin : HX →ₗ[ℚ] HY)
    (hJ : ∀ W : CY, clE (jChow W) = jBetti (clY W))
    (hQ : ∀ V : CE, clX (qChow V) = qReturn (clE V))
    (hSelf : ∀ a : HX, jBetti (excGysin a) = -(xiMul (qPull a)))
    (hFiber : ∀ a : HX, qReturn (xiMul (qPull a)) = a)
    (hRationalBlowupComplete : Function.Surjective clY) :
    Function.Surjective clX := by
  intro a
  obtain ⟨W, hW⟩ := hRationalBlowupComplete (excGysin a)
  exact ⟨exceptionalOriginalXCycle jChow qChow W,
    exceptional_lift_cycle_recovery clX clY clE jChow qChow
      jBetti qReturn xiMul qPull excGysin hJ hQ
      hSelf hFiber a W hW⟩

#check exceptional_ambient_surjectivity_forces_original
#print axioms exceptional_ambient_surjectivity_forces_original

#check exceptional_lift_return_identity
#check exceptional_lift_cycle_recovery
