(* Exact rank-adaptive corner GST: 12 original carry/trit states.
  Inputs are ORIGINAL U+J+SURVIVE GST wave, original two-cell seed,
  source rank-one coupler vv^T. No convenient surrogate wave matrix.
  Math claim: Krylov K invertible -> rational matrix units
  U_ij = K E_ij K^-1 lie in algebra generated by original U,J,M
  and P=vv^T (because T^T=U^4-J+M and G=K^T K invertible).
  For each 1<=r<=12 the rank-r idempotent e_r=sum_i U_ii and
  rank-adaptive cyclic fold C_r=sum_i U_(i+1 mod r),i have determinant
  of rational Hankel = (-1)^((r(r-1))/2), NOT limited to r divisible 12.
  All calculations are exact rational. These are information operators,
  NOT automatically actual Chow correspondences on arbitrary original X.
*)
ClearAll[cells,loc,two,mid,last,survive,pos,uuu,jjj,mmm,ttt,powerNat,
 seed,kk,kinv,gmat,ginv,sourceP,matunit,rankCase,
 cases,expressionCheck,result];
powerNat[m_,n_Integer?NonNegative]:=If[n==0,IdentityMatrix[Length[m]],MatrixPower[m,n]];
cells=Flatten[Table[{c,d},{c,0,3},{d,0,2}],1];
loc[a_]:=First[FirstPosition[cells,a]];
two[z_]:=Boole[z==2];
mid[c_,d_]:=Mod[Quotient[c,2]+2d,3];
last[c_,d_]:=Mod[Mod[c,2]+2mid[c,d],3];
survive[c_,d_]:=two[d]*two[mid[c,d]]+two[mid[c,d]]*two[last[c,d]];
pos={0,1,3,4,5,9};
uuu=Table[Boole[j==loc[{
 Quotient[First[cells[[i]]]+4Last[cells[[i]]],3],
 Mod[First[cells[[i]]]+4Last[cells[[i]]],3]}]],
 {i,12},{j,12}];
jjj=Table[If[MemberQ[pos,First[cells[[i]]]+4Last[cells[[i]]]],1,-1]*
 Boole[j==loc[{3-First[cells[[i]]],2-Last[cells[[i]]]}]],
 {i,12},{j,12}];
mmm=DiagonalMatrix[(survive@@#)&/@cells];
ttt=uuu+jjj+mmm;
seed=Boole[MemberQ[{{0,0},{0,1}},#]]&/@cells;
kk=Transpose[NestList[ttt.#&,seed,11]];
kinv=Inverse[kk];
gmat=Transpose[kk].kk;
ginv=Inverse[gmat];
sourceP=Outer[Times,seed,seed];
matunit[i_,j_]:=Outer[Times,kk[[All,i]],kinv[[j]]];
expressionCheck=Module[{i=5,j=9,byNativeWords},
 byNativeWords=Sum[ginv[[j,k]]*
  powerNat[ttt,i-1].sourceP.powerNat[Transpose[ttt],k-1],
  {k,1,12}];
 byNativeWords==matunit[i,j]];
rankCase[r_Integer?Positive]:=Module[
 {proj,cyc,orbit,read,hank,anti,unitRank,zero12=ConstantArray[0,{12,12}]},
 proj=Sum[matunit[i,i],{i,1,r}];
 cyc=Sum[matunit[Mod[i,r]+1,i],{i,1,r}];
 orbit=Transpose[NestList[cyc.#&,seed,r-1]];
 read=kinv[[r]];
 With[{mom=read.#&/@NestList[cyc.#&,seed,2r-2]},
 hank=Table[mom[[i+j+1]],{i,0,r-1},{j,0,r-1}]];
 anti=And@@Flatten[Table[
  If[i+j<r-1,hank[[i+1,j+1]]==0,
   If[i+j==r-1,hank[[i+1,j+1]]==1,True]],
  {i,0,r-1},{j,0,r-1}]];
 <|"r"->r,"cornerRank"->MatrixRank[proj],
   "idempotent"->(proj.proj==proj),
   "cornerSupportsFold"->(proj.cyc==cyc&&cyc.proj==cyc),
   "cyclicOrder"->(MatrixPower[cyc,r]==proj),
   "cornerOrbitRank"->MatrixRank[orbit],
   "antiTriangularMoments"->anti,
   "HankelDet"->Det[hank],
   "expectedSign"->(-1)^(r(r-1)/2),
   "pass"->(MatrixRank[proj]==r && proj.proj==proj &&
    proj.cyc==cyc && cyc.proj==cyc && MatrixPower[cyc,r]==proj &&
    MatrixRank[orbit]==r && anti &&
    Det[hank]==(-1)^(r(r-1)/2))|>];
cases=Table[rankCase[r],{r,1,12}];
result=<|"originalGSTBaseKrylovDet"->Det[kk],
 "originalGSTSeed"->seed,
 "originalU5"->(MatrixPower[uuu,5]==IdentityMatrix[12]),
 "originalJ2"->(jjj.jjj==-IdentityMatrix[12]),
 "originalTransposeContained"->(Transpose[ttt]==MatrixPower[uuu,4]-jjj+mmm),
 "KrylovGramInvertible"->(Det[gmat]!=0),
 "nativeWordMatrixUnitReconstruction"->expressionCheck,
 "ranksTested"->Length[cases],
 "adaptiveCorners"->(KeyTake[# ,{"r","cornerRank","cyclicOrder","cornerOrbitRank","HankelDet","expectedSign","pass"}]&/@cases),
 "allPassed"->(Det[kk]!=0 && expressionCheck &&
  And@@(Lookup[#,"pass"]&/@cases))|>;
Print[result];result