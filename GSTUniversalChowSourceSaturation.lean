import Mathlib

/-!
# GST universal original-X algebraic-source saturation and rank-two firewall

For any smooth connected projective complex X, any codimension p,
and ample h, let q=degree(h^d)>0. Every actual Chow cycle Z gives
the genuine exterior-product correspondence
  Gamma_Z = q^-1 pr1*(h^(d-p)) pr2*(Z) in CH^d(X x X)_Q.
Its action is A -> ell_h(A) Z, with ell_h(h^p)=1.
Consequently its action ON THE SINGLE SEED h^p is exactly Z.
Hence the WHOLE algebraic cycle class image, for arbitrary X, is
generated by the cardinal-indexed family of actual correspondences
on one native seed.

This file formalizes the corresponding rational-module source
evaluation theorem, including the exact obstruction: using ONLY
these common-readout rank-one operators and one fixed fold,
all ordinary iterates remain in a span of dimension at most two.
The actual Chow exterior-product geometry is proved separately in
the accompanying derivation; not assumed to follow from a linear
operator alone.

No Hodge surjectivity, target-cycle inverse, or universal source-birth
assumption appears here.
-/

set_option maxHeartbeats 1000000

noncomputable section
namespace GSTUniversalChowSourceSaturation

universe u
variable {A : Type u} [AddCommGroup A] [Module ℚ A]

/-- Rational rank-one correspondence action on the Chow module. -/
def sourceAction (ell : A →ₗ[ℚ] ℚ) (target : A) :
    Module.End ℚ A where
  toFun z := ell z • target
  map_add' := by
    intro x y
    simp [map_add, add_smul]
  map_smul' := by
    intro q x
    simp [map_smul, smul_smul]

/-- A new cardinal-indexed source target gives a GENUINE native orbit
output equal to that target when the original ample seed is normalized. -/
theorem sourceAction_seed_eq
    (ell : A →ₗ[ℚ] ℚ) (seed target : A)
    (hseed : ell seed = 1) :
    sourceAction ell target seed = target := by
  change ell seed • target = target
  simp [hseed]

/-- The complete family of rank-one correspondence sources indexed by
ALL native rational cycles evaluates surjectively on the seed.
This is SURJECTIVITY ON NATIVE ALGEBRAIC CYCLES, NOT surjectivity
of the canonical cycle-class map onto all Hodge classes. -/
theorem all_native_sources_reached_from_one_seed
    (ell : A →ₗ[ℚ] ℚ) (seed : A)
    (hseed : ell seed = 1) :
    Function.Surjective (fun target : A => sourceAction ell target seed) := by
  intro target
  exact ⟨target, sourceAction_seed_eq ell seed target hseed⟩

/-- The tempting single-fold combination with a COMMON source
readout is the identity plus one rank-one operator. -/
def commonReadoutFold
    (ell : A →ₗ[ℚ] ℚ) (target : A) :
    Module.End ℚ A :=
  LinearMap.id + sourceAction ell target

def commonReadoutOrbit
    (ell : A →ₗ[ℚ] ℚ) (target seed : A) : ℕ → A
  | 0 => seed
  | n + 1 => commonReadoutFold ell target
      (commonReadoutOrbit ell target seed n)

/-- Every ordinary iteration of ANY single common-readout fold
remains within the span of only seed and its target. A cardinal
number of different rank-one sources cannot be compressed into
one single-readout rank-greater-than-two fold just by summing them. -/
theorem commonReadoutOrbit_in_two_source_span
    (ell : A →ₗ[ℚ] ℚ) (target seed : A) :
    ∀ n : ℕ,
      commonReadoutOrbit ell target seed n ∈
        Submodule.span ℚ ({seed, target} : Set A) := by
  intro n
  induction n with
  | zero =>
      change seed ∈ Submodule.span ℚ ({seed, target} : Set A)
      apply Submodule.subset_span
      simp
  | succ n ih =>
      change
        commonReadoutOrbit ell target seed n +
          ell (commonReadoutOrbit ell target seed n) • target ∈
        Submodule.span ℚ ({seed, target} : Set A)
      apply add_mem ih
      apply smul_mem
      apply Submodule.subset_span
      simp

#check sourceAction_seed_eq
#check all_native_sources_reached_from_one_seed
#check commonReadoutOrbit_in_two_source_span

#print axioms sourceAction_seed_eq
#print axioms all_native_sources_reached_from_one_seed
#print axioms commonReadoutOrbit_in_two_source_span

end GSTUniversalChowSourceSaturation
