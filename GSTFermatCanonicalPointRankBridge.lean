import GSTClassicalHodgeGeometricCycleClassPointRigidity
import GSTMaximalLinearHypersurfacePrimitive

/-!
# Genuine native codimension-point cycles and geometric rank

Each class source is an ACTUAL native codimension-point cycle, not
a chosen vector in an abstract rational Hodge target. The point
fundamental-class map is uniquely extended to all algebraic cycles.

An independently geometric intersection-number comparison gives a
nondegenerate Gram matrix. The latter is not assumed via target Hodge
surjectivity or a cycle preimage of an unknown Hodge direction.

Still NOT the universal all-varieties Hodge spanning theorem:
actual Betti point-class construction and geometric intersection
comparison on arbitrary X are separate mathematical obligations.
-/

set_option maxHeartbeats 10000000
noncomputable section

open AlgebraicGeometry
open GSTProjectiveOverC
open GSTGeometricRealizationStage2D
open GSTGeometricRealizationStage2F
open GSTGeometricRealizationStage2G
open GSTNativeCodimensionCyclePresentation
open GSTClassicalHodgeGeometricCycleClassPointRigidity
open GSTMaximalLinearHypersurfacePrimitive

namespace GSTFermatCanonicalPointRankBridge

variable {V : SmoothProjectiveComplexScheme}

/-- True codimension-p source generated by an irreducible
subvariety point, with hyperplane-power correction. -/
noncomputable def nativePrimitiveFromPlane
    (p d : ℕ) (points : Fin d → CodimensionPoint V.X p)
    (Hpower : codimensionCycles V.X p) (i : Fin d) :
    codimensionCycles V.X p :=
  (d : ℚ) • codimensionPointCycle V.X p (points i) - Hpower

/-- No nontrivial rational relation among the actual
point-generated geometric Betti classes when their concrete
intersection measurements equal the Fermat normal-Chern Gram. -/
theorem genuine_point_generated_fermat_rank
    (p d m : ℕ) (hd : 3 ≤ d) (hm : 1 ≤ m)
    (A : AnalytificationData V)
    (pt : PointBettiClass (V := V) p A)
    (points : Fin d → CodimensionPoint V.X p)
    (Hpower : codimensionCycles V.X p)
    (M : RationalSingularCohomology A (2 * p) →ₗ[ℚ] (Fin d → ℚ))
    (hEntry : ∀ i j : Fin d,
      (M (cycleClassFromPointGeometry (V := V) p A pt
        (nativePrimitiveFromPlane (V := V) p d points Hpower i))) j =
          if i = j then
            (d:ℚ)^2 * ((NormalTopCoeff (d:ℤ) m : ℤ) : ℚ) - (d:ℚ)
          else -(d:ℚ))
    (a : Fin d → ℚ)
    (hZero :
      (∑ i : Fin d, a i •
        cycleClassFromPointGeometry (V := V) p A pt
          (nativePrimitiveFromPlane (V := V) p d points Hpower i)) = 0) :
    ∀ i, a i = 0 := by
  let F := cycleClassFromPointGeometry (V := V) p A pt
  let Z := nativePrimitiveFromPlane (V := V) p d points Hpower
  let E : Fin d → RationalSingularCohomology A (2 * p) :=
    fun i => F (Z i)
  have hGram : ∀ b : Fin d → ℚ,
      M (∑ i : Fin d, b i • E i) =
        (fun j => fermatMaximalPlaneGramDetector d m b j) := by
    intro b
    funext j
    change (M (∑ i : Fin d, b i • F (Z i))) j =
        fermatMaximalPlaneGramDetector d m b j
    calc
      (M (∑ i : Fin d, b i • F (Z i))) j =
        ∑ i : Fin d, b i * (M (F (Z i))) j := by
          simp only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply,
            smul_eq_mul]
      _ = ∑ i : Fin d, b i *
          (if i = j then
            (d:ℚ)^2 * ((NormalTopCoeff (d:ℤ) m : ℤ) : ℚ) - (d:ℚ)
           else -(d:ℚ)) := by
          apply Finset.sum_congr rfl
          intro i _
          rw [show M (F (Z i)) j =
            (if i = j then
              (d:ℚ)^2 * ((NormalTopCoeff (d:ℤ) m : ℤ) : ℚ) - (d:ℚ)
             else -(d:ℚ)) from hEntry i j]
      _ = fermatMaximalPlaneGramDetector d m b j := by
          classical
          let C : ℚ := (d:ℚ)^2 *
            ((NormalTopCoeff (d:ℤ) m : ℤ) : ℚ)
          let D : ℚ := d
          have hterm (i : Fin d) :
              b i * (if i=j then C-D else -D) =
                (if i=j then C*b i else 0) - D*b i := by
              split_ifs <;> ring
          change (∑ i : Fin d, b i * (if i=j then C-D else -D)) =
            C*b j - D*(∑ i : Fin d, b i)
          simp_rw [hterm]
          rw [Finset.sum_sub_distrib]
          simp [← Finset.mul_sum]
  have hz : (∑ i : Fin d, a i • E i) = 0 := by
    exact hZero
  exact fermatGeometricMeasuredFamily_independent d m hd hm E M hGram a hz

#check nativePrimitiveFromPlane
#check genuine_point_generated_fermat_rank
#print axioms genuine_point_generated_fermat_rank

end GSTFermatCanonicalPointRankBridge
